@using FarmaciaSmart.Web.Models.ViewModels.Sales
@model List<CartItemDto>
@{
    ViewData["Title"] = "Checkout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/shop.css" asp-append-version="true" />
}

<div class="shop-page">
    <h4>Checkout</h4>
    <p class="text-muted">This submits a pre-order for pickup at <strong>@ViewBag.BranchName</strong>. No payment is taken online &mdash; you pay in-store when you pick it up.</p>

    <div class="shop-sidebar">
        <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>Quantity</th>
                    <th>Line Total</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.ProductName</td>
                    <td>@item.Quantity</td>
                    <td>@item.LineTotal.ToString("N2")</td>
                </tr>
            }
            </tbody>
        </table>
        </div>
        <p class="text-end"><strong>Total: @Model.Sum(i => i.LineTotal).ToString("N2")</strong></p>

        <form asp-action="Checkout" method="post">
            <div class="mb-3">
                <label class="form-label">Notes for the pharmacy (optional)</label>
                <textarea name="notes" class="form-control" rows="2"></textarea>
            </div>
            <a asp-action="Cart" class="btn btn-outline-secondary">Back to Cart</a>
            <button type="submit" class="btn btn-shop-primary">Submit Order</button>
        </form>
    </div>
</div>
