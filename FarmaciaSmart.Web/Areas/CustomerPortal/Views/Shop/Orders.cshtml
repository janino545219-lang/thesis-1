@using FarmaciaSmart.Web.Models.Entities
@model List<CustomerOrder>
@{
    ViewData["Title"] = "My Orders";
}

@section Styles {
    <link rel="stylesheet" href="~/css/shop.css" asp-append-version="true" />
}

<div class="shop-page">
    <h4>My Orders</h4>
    <p><a asp-action="Index" class="btn btn-shop-primary">Back to Shop</a></p>

    @if (Model.Count == 0)
    {
        <p class="text-muted">You haven't placed any orders yet.</p>
    }
    else
    {
        <div class="shop-sidebar">
            <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Order #</th>
                        <th>Branch</th>
                        <th>Items</th>
                        <th>Total</th>
                        <th>Status</th>
                        <th>Placed</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var order in Model)
                {
                    <tr>
                        <td>@order.OrderNumber</td>
                        <td>@order.Branch.Name</td>
                        <td>@order.Items.Sum(i => i.Quantity)</td>
                        <td>@order.TotalAmount.ToString("N2")</td>
                        <td>@order.Status</td>
                        <td>@order.CreatedAt.ToString("g")</td>
                        <td><a asp-action="OrderDetails" asp-route-id="@order.Id" class="btn btn-sm btn-outline-secondary">View</a></td>
                    </tr>
                }
                </tbody>
            </table>
            </div>
        </div>
    }
</div>
