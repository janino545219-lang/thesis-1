@using FarmaciaSmart.Web.Models.Entities
@model CustomerOrder
@{
    ViewData["Title"] = "Order Details";
}

@section Styles {
    <link rel="stylesheet" href="~/css/shop.css" asp-append-version="true" />
}

<div class="shop-page">
    <h4>Order @Model.OrderNumber</h4>

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success">@success</div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger">@error</div>
    }

    <div class="shop-sidebar mb-3">
        <p>Pickup branch: <strong>@Model.Branch.Name</strong></p>
        <p>Status: <strong>@Model.Status</strong></p>
        @if (!string.IsNullOrWhiteSpace(Model.Notes))
        {
            <p>Notes: @Model.Notes</p>
        }
        @if (Model.Status == CustomerOrderStatus.Fulfilled)
        {
            <p class="text-success">Picked up on @Model.FulfilledAt?.ToString("g")</p>
        }

        <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>Quantity</th>
                    <th>Unit Price</th>
                    <th>Line Total</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@item.Product.Name</td>
                    <td>@item.Quantity</td>
                    <td>@item.UnitPriceAtOrderTime.ToString("N2")</td>
                    <td>@((item.UnitPriceAtOrderTime * item.Quantity).ToString("N2"))</td>
                </tr>
            }
            </tbody>
        </table>
        </div>
        <p class="text-end"><strong>Total: @Model.TotalAmount.ToString("N2")</strong></p>

        @if (Model.Status == CustomerOrderStatus.Pending)
        {
            <form asp-action="CancelOrder" asp-route-id="@Model.Id" method="post">
                <button type="submit" class="btn btn-outline-danger">Cancel Order</button>
            </form>
        }
    </div>

    <a asp-action="Orders" class="btn btn-outline-secondary">Back to My Orders</a>
</div>
