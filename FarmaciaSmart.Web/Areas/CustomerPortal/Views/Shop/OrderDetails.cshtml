@using FarmaciaSmart.Web.Models.Entities
@model CustomerOrder
@{
    ViewData["Title"] = $"Pre-Order #{Model.OrderNumber} - Farmacia San Antonio";
}

@section Styles {
    <link rel="stylesheet" href="~/css/shop.css" asp-append-version="true" />
    <style>
        .order-timeline {
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: relative;
            padding: 1.5rem 0;
            margin: 1rem 0 2rem;
        }
        .order-timeline::before {
            content: "";
            position: absolute;
            top: 50%;
            left: 10%;
            right: 10%;
            height: 3px;
            background: #E5E7EB;
            z-index: 1;
            transform: translateY(-50%);
        }
        .order-step {
            position: relative;
            z-index: 2;
            background: #ffffff;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 0 1rem;
        }
        .order-step-circle {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 0.85rem;
            margin-bottom: 0.5rem;
            border: 2px solid #E5E7EB;
            background: #ffffff;
            color: #697386;
        }
        .order-step.completed .order-step-circle {
            background: #239B80;
            border-color: #239B80;
            color: #ffffff;
        }
        .order-step.active .order-step-circle {
            background: #326BE8;
            border-color: #326BE8;
            color: #ffffff;
            box-shadow: 0 0 0 4px rgba(50, 107, 232, 0.2);
        }
        .order-step.cancelled .order-step-circle {
            background: #B91C2B;
            border-color: #B91C2B;
            color: #ffffff;
        }
    </style>
}

<div class="shop-page py-2">
    <!-- Breadcrumb & Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-action="Orders">My Orders</a></li>
                    <li class="breadcrumb-item active" aria-current="page">@Model.OrderNumber</li>
                </ol>
            </nav>
            <h2 class="fw-bold mb-0 text-navy">Pre-Order Details</h2>
        </div>
        <div>
            <a asp-action="Orders" class="btn btn-outline-secondary btn-sm">
                &larr; Back to My Pre-Orders
            </a>
        </div>
    </div>

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success d-flex align-items-center gap-2 mb-4" role="alert">
            <span>&#10003;</span>
            <div>@success</div>
        </div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger d-flex align-items-center gap-2 mb-4" role="alert">
            <span>&#9888;</span>
            <div>@error</div>
        </div>
    }

    <!-- Order Timeline / Lifecycle -->
    <div class="card p-4 shadow-sm mb-4">
        <h6 class="fw-bold text-navy mb-3">Order Status Lifecycle</h6>
        @if (Model.Status == CustomerOrderStatus.Cancelled)
        {
            <div class="order-timeline">
                <div class="order-step completed">
                    <div class="order-step-circle">&#10003;</div>
                    <span class="small fw-semibold text-navy">Order Placed</span>
                </div>
                <div class="order-step cancelled">
                    <div class="order-step-circle">&#10005;</div>
                    <span class="small fw-semibold text-danger">Order Cancelled</span>
                </div>
            </div>
        }
        else
        {
            <div class="order-timeline">
                <div class="order-step completed">
                    <div class="order-step-circle">&#10003;</div>
                    <span class="small fw-semibold text-navy">1. Submitted Online</span>
                </div>
                <div class="order-step @(Model.Status == CustomerOrderStatus.Pending ? "active" : "completed")">
                    <div class="order-step-circle">@(Model.Status == CustomerOrderStatus.Fulfilled ? "\u2713" : "2")</div>
                    <span class="small fw-semibold text-navy">2. Prepared for Pickup</span>
                </div>
                <div class="order-step @(Model.Status == CustomerOrderStatus.Fulfilled ? "completed" : "")">
                    <div class="order-step-circle">@(Model.Status == CustomerOrderStatus.Fulfilled ? "\u2713" : "3")</div>
                    <span class="small fw-semibold text-navy">3. In-Store Collection</span>
                </div>
            </div>
        }
    </div>

    <!-- Branch Pickup & Status Card -->
    <div class="card p-4 shadow-sm mb-4">
        <div class="row g-3">
            <div class="col-12 col-md-3">
                <span class="text-muted small text-uppercase fw-bold">Order Number</span>
                <div class="fw-bold text-navy fs-6 font-monospace">@Model.OrderNumber</div>
            </div>
            <div class="col-12 col-md-3">
                <span class="text-muted small text-uppercase fw-bold">Pickup Branch</span>
                <div class="fw-bold text-navy fs-6">@Model.Branch.Name</div>
                <div class="text-muted small">@Model.Branch.Address</div>
            </div>
            <div class="col-12 col-md-3">
                <span class="text-muted small text-uppercase fw-bold">Order Status</span>
                <div class="mt-1">
                    @{
                        var statusBadge = Model.Status switch
                        {
                            CustomerOrderStatus.Fulfilled => "bg-success text-white",
                            CustomerOrderStatus.Cancelled => "bg-danger text-white",
                            _ => "bg-warning text-dark"
                        };
                    }
                    <span class="badge @statusBadge fs-6">
                        @(Model.Status == CustomerOrderStatus.Pending ? "Awaiting In-Store Pickup" : Model.Status.ToString())
                    </span>
                </div>
            </div>
            <div class="col-12 col-md-3">
                <span class="text-muted small text-uppercase fw-bold">Submitted Date</span>
                <div class="fw-bold text-navy fs-6">@Model.CreatedAt.ToString("MMM d, yyyy")</div>
                <div class="text-muted small">@Model.CreatedAt.ToString("hh:mm tt")</div>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Notes))
        {
            <div class="mt-3 pt-3 border-top">
                <span class="text-muted small text-uppercase fw-bold">Customer Notes:</span>
                <p class="mb-0 text-navy small">@Model.Notes</p>
            </div>
        }

        @if (Model.Status == CustomerOrderStatus.Fulfilled && Model.FulfilledAt.HasValue)
        {
            <div class="mt-3 pt-3 border-top text-success small fw-semibold">
                <span>&#10003;</span> Picked up and paid in-store on @Model.FulfilledAt.Value.ToString("MMM d, yyyy hh:mm tt")
            </div>
        }
    </div>

    <!-- Items Table -->
    <div class="card p-0 overflow-hidden shadow-sm mb-4">
        <div class="p-3 bg-light border-bottom">
            <h6 class="fw-bold text-navy mb-0">Pre-Ordered Items</h6>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Product</th>
                        <th class="text-center">Quantity</th>
                        <th class="text-end">Unit Price</th>
                        <th class="text-end">Line Total</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>
                            <div class="fw-bold text-navy">@item.Product.Name</div>
                            <div class="text-muted small">@(item.Product.Brand ?? "Generic") &middot; @(item.Product.Unit ?? "Unit")</div>
                        </td>
                        <td class="text-center fw-semibold">
                            @item.Quantity
                        </td>
                        <td class="text-end">
                            &#8369;@item.UnitPriceAtOrderTime.ToString("N2")
                        </td>
                        <td class="text-end fw-bold text-navy">
                            &#8369;@((item.UnitPriceAtOrderTime * item.Quantity).ToString("N2"))
                        </td>
                    </tr>
                }
                </tbody>
                <tfoot class="table-light">
                    <tr>
                        <td colspan="3" class="text-end fw-bold fs-6">Total Amount to Pay at Pickup:</td>
                        <td class="text-end fw-bold fs-5 text-primary">&#8369;@Model.TotalAmount.ToString("N2")</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>

    <!-- Action Buttons -->
    <div class="d-flex justify-content-between align-items-center">
        <a asp-action="Orders" class="btn btn-outline-secondary">
            &larr; Back to My Orders
        </a>

        @if (Model.Status == CustomerOrderStatus.Pending)
        {
            <form asp-action="CancelOrder" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Are you sure you want to cancel this pre-order?');">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger">
                    Cancel This Pre-Order
                </button>
            </form>
        }
    </div>
</div>
