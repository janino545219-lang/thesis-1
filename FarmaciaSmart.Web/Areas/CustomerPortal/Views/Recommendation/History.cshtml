@model List<Recommendation>
@{
    ViewData["Title"] = "My Recommendations";
}

<h2>My Recommendations</h2>

@if (Model.Count == 0)
{
    <p class="text-muted">No recommendation requests yet.</p>
}
else
{
    <div class="table-responsive">
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Date</th>
                <th>Concern</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var rec in Model)
        {
            <tr>
                <td>@rec.CreatedAt.ToString("g")</td>
                <td>@rec.RequestText</td>
                <td>
                    @switch (rec.ReviewStatus)
                    {
                        case RecommendationReviewStatus.PendingReview:
                            <span class="badge bg-secondary">Pending Review</span>
                            break;
                        case RecommendationReviewStatus.Approved:
                            <span class="badge bg-success">Approved</span>
                            break;
                        case RecommendationReviewStatus.Modified:
                            <span class="badge bg-info text-dark">Modified</span>
                            break;
                        case RecommendationReviewStatus.Rejected:
                            <span class="badge bg-danger">Rejected</span>
                            break;
                    }
                </td>
                <td><a asp-action="Result" asp-route-id="@rec.Id" class="btn btn-sm btn-outline-primary">View</a></td>
            </tr>
        }
        </tbody>
    </table>
    </div>
}

<a asp-action="Index" class="btn btn-secondary">Ask a New Question</a>
