@using FarmaciaSmart.Web.Areas.CustomerPortal.Models.ViewModels
@using FarmaciaSmart.Web.Models.Entities
@model CustomerDashboardViewModel
@{
    ViewData["Title"] = "Customer Dashboard - Farmacia San Antonio";
}

@section Styles {
    <link rel="stylesheet" href="~/css/analytics.css" asp-append-version="true" />
    <style>
        .customer-welcome-hero {
            background: linear-gradient(135deg, #172033 0%, #1f2d47 60%, #B91C2B 100%);
            border-radius: 16px;
            color: #ffffff;
            padding: 2rem 2.25rem;
            margin-bottom: 1.75rem;
            box-shadow: 0 10px 30px rgba(23, 32, 51, 0.12);
        }
        .customer-welcome-hero h2 {
            font-size: 1.85rem;
            font-weight: 800;
            margin-bottom: 0.5rem;
        }
        .customer-welcome-hero p {
            color: rgba(255, 255, 255, 0.85);
            font-size: 0.95rem;
            max-width: 600px;
            margin-bottom: 1.25rem;
        }
        .customer-chip {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            background: rgba(255, 255, 255, 0.12);
            backdrop-filter: blur(8px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            padding: 0.4rem 0.85rem;
            border-radius: 9999px;
            font-size: 0.82rem;
            font-weight: 500;
            color: #fff;
        }
        .stat-card-custom {
            background: #ffffff;
            border: 1px solid #E5E7EB;
            border-radius: 14px;
            padding: 1.5rem;
            box-shadow: 0 4px 16px rgba(23, 32, 51, 0.05);
            height: 100%;
            transition: transform 0.2s, box-shadow 0.2s;
        }
        .stat-card-custom:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(23, 32, 51, 0.08);
        }
        .stat-card-custom.primary {
            background: #B91C2B;
            border-color: #B91C2B;
            color: #ffffff;
        }
        .stat-card-custom.primary .stat-label {
            color: rgba(255, 255, 255, 0.85);
        }
        .stat-card-custom.primary .stat-value {
            color: #ffffff;
        }
        .order-step-badge {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 0.75rem;
        }
    </style>
}

<div class="analytics-page py-2">
    @if (TempData["Success"] is string successMsg)
    {
        <div class="alert alert-success d-flex align-items-center gap-2 mb-4" role="alert">
            <span>&#10003;</span>
            <div>@successMsg</div>
        </div>
    }

    <!-- Welcome Hero Banner -->
    <div class="customer-welcome-hero">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <h2>Welcome Back, @Model.Customer.User.FirstName!</h2>
                <p>Access in-stock medicines, track your branch pre-orders, and explore pharmacist-reviewed recommendations.</p>
                <div class="d-flex flex-wrap gap-2">
                    <span class="customer-chip">
                        <span>&#127970;</span> Preferred Branch: <strong>@(Model.Customer.PreferredBranch?.Name ?? "No branch set")</strong>
                    </span>
                    <span class="customer-chip">
                        <span>&#9989;</span> Account Status: <strong>@Model.Customer.Status</strong>
                    </span>
                </div>
            </div>
            <div class="d-flex gap-2">
                <a asp-controller="Shop" asp-action="Index" class="btn btn-light text-navy fw-bold px-3 py-2">
                    Browse Products &rarr;
                </a>
            </div>
        </div>
    </div>

    <!-- Quick Stats Cards -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-md-6 col-lg-3">
            <div class="stat-card-custom primary">
                <div class="stat-label">Total Spent</div>
                <div class="stat-value fs-2 fw-bold mb-1">&#8369;@Model.TotalSpent.ToString("N2")</div>
                <div class="small" style="color: rgba(255,255,255,0.8)">Lifetime in-store purchases</div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-lg-3">
            <div class="stat-card-custom">
                <div class="stat-label text-muted small fw-bold text-uppercase">Pre-Orders Placed</div>
                <div class="stat-value fs-2 fw-bold mb-1 text-navy">@Model.TotalOrders</div>
                <a asp-controller="Shop" asp-action="Orders" class="small text-decoration-none fw-semibold" style="color: #326BE8">View pre-order history &rarr;</a>
            </div>
        </div>
        <div class="col-12 col-md-6 col-lg-3">
            <div class="stat-card-custom">
                <div class="stat-label text-muted small fw-bold text-uppercase">Pending Pickup</div>
                <div class="stat-value fs-2 fw-bold mb-1 text-navy">@Model.PendingOrders</div>
                <div class="small text-muted">Awaiting pickup at branch counter</div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-lg-3">
            <div class="stat-card-custom">
                <div class="stat-label text-muted small fw-bold text-uppercase">AI Recommendations</div>
                <div class="stat-value fs-2 fw-bold mb-1 text-navy">@Model.RecommendationsReceived</div>
                <a asp-controller="Recommendation" asp-action="History" class="small text-decoration-none fw-semibold" style="color: #326BE8">Review guidance history &rarr;</a>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-md-4">
            <div class="card p-3 h-100">
                <div class="d-flex align-items-center gap-3 mb-2">
                    <div class="p-2 rounded-3 text-white" style="background: #326BE8;">&#128722;</div>
                    <h6 class="fw-bold mb-0 text-navy">Shop Medicine Catalog</h6>
                </div>
                <p class="text-secondary small flex-grow-1">Browse branch inventory, verify medicine availability, and preorder for quick pickup.</p>
                <a asp-controller="Shop" asp-action="Index" class="btn btn-sm btn-outline-primary w-100">Browse Products</a>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card p-3 h-100">
                <div class="d-flex align-items-center gap-3 mb-2">
                    <div class="p-2 rounded-3 text-white" style="background: #B91C2B;">&#129502;</div>
                    <h6 class="fw-bold mb-0 text-navy">Ask AI Guidance</h6>
                </div>
                <p class="text-secondary small flex-grow-1">Get pharmacist-approved OTC recommendations tailored to your wellness needs.</p>
                <a asp-controller="Recommendation" asp-action="Index" class="btn btn-sm btn-outline-primary w-100" onclick="if(window.FarmaciaChatbot){window.FarmaciaChatbot.open();return false;}">Open AI Chatbot &rarr;</a>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card p-3 h-100">
                <div class="d-flex align-items-center gap-3 mb-2">
                    <div class="p-2 rounded-3 text-white" style="background: #239B80;">&#128100;</div>
                    <h6 class="fw-bold mb-0 text-navy">Customer Profile</h6>
                </div>
                <p class="text-secondary small flex-grow-1">Update your preferred pickup branch, contact number, or account password.</p>
                <a asp-controller="Profile" asp-action="Index" class="btn btn-sm btn-outline-primary w-100">Manage Profile</a>
            </div>
        </div>
    </div>

    <!-- Charts Section -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-lg-7">
            <div class="analytics-card p-3 h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold text-navy mb-0">Monthly Purchase Trend</h6>
                    <span class="text-muted small">In-store transactions (last 6 months)</span>
                </div>
                <canvas id="spendingTrendChart" height="200"></canvas>
            </div>
        </div>
        <div class="col-12 col-lg-5">
            <div class="analytics-card p-3 h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold text-navy mb-0">Pre-Order Status Distribution</h6>
                    <span class="text-muted small">All pre-orders</span>
                </div>
                @if (Model.TotalOrders == 0)
                {
                    <div class="text-center py-5">
                        <div class="fs-1 text-muted mb-2">&#128230;</div>
                        <p class="text-muted small mb-0">You have not placed any pre-orders yet.</p>
                    </div>
                }
                else
                {
                    <canvas id="orderStatusChart" height="200"></canvas>
                }
            </div>
        </div>
    </div>

    <!-- Recent Records -->
    <div class="row g-3">
        <div class="col-12 col-lg-7">
            <div class="analytics-card p-3 h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold text-navy mb-0">Recent In-Store Purchases</h6>
                    <span class="text-muted small">Verified POS sales</span>
                </div>
                @if (Model.RecentPurchases.Count == 0)
                {
                    <p class="text-muted small mb-0 py-3">No completed purchases yet. Purchases made at any Farmacia San Antonio branch under your account will appear here.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Branch</th>
                                    <th>Items</th>
                                    <th class="text-end">Total Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var sale in Model.RecentPurchases)
                            {
                                <tr>
                                    <td>@sale.SaleDate.ToString("MMM d, yyyy")</td>
                                    <td><span class="badge bg-light text-navy border">@sale.Branch.Name</span></td>
                                    <td>@sale.Items.Sum(i => i.Quantity) item(s)</td>
                                    <td class="text-end fw-bold text-navy">&#8369;@sale.TotalAmount.ToString("N2")</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
        <div class="col-12 col-lg-5">
            <div class="analytics-card p-3 h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold text-navy mb-0">Pharmacist AI Recommendations</h6>
                    <a asp-controller="Recommendation" asp-action="History" class="small text-decoration-none">View All</a>
                </div>
                @if (Model.RecentRecommendations.Count == 0)
                {
                    <p class="text-muted small mb-0 py-3">You have not requested an AI recommendation yet.</p>
                }
                else
                {
                    <div class="list-group list-group-flush">
                        @foreach (var rec in Model.RecentRecommendations)
                        {
                            var badgeClass = rec.ReviewStatus switch
                            {
                                RecommendationReviewStatus.Approved => "bg-success text-white",
                                RecommendationReviewStatus.Modified => "bg-info text-white",
                                RecommendationReviewStatus.Rejected => "bg-danger text-white",
                                _ => "bg-secondary text-white"
                            };
                            <a asp-controller="Recommendation" asp-action="Result" asp-route-id="@rec.Id" 
                               class="list-group-item list-group-item-action d-flex justify-content-between align-items-center px-0 py-2 border-0 border-bottom">
                                <div>
                                    <div class="fw-semibold text-navy">@rec.Category.Name</div>
                                    <div class="text-muted small">@rec.CreatedAt.ToString("MMM d, yyyy")</div>
                                </div>
                                <span class="badge @badgeClass">@rec.ReviewStatus</span>
                            </a>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    const spendLabels = @Html.Raw(Json.Serialize(Model.SpendingTrend.Select(p => p.MonthLabel)));
    const spendData = @Html.Raw(Json.Serialize(Model.SpendingTrend.Select(p => p.TotalAmount)));
    
    var spendCanvas = document.getElementById('spendingTrendChart');
    if (spendCanvas) {
        new Chart(spendCanvas, {
            type: 'bar',
            data: { 
                labels: spendLabels, 
                datasets: [{ 
                    label: 'Amount Spent (₱)', 
                    data: spendData, 
                    backgroundColor: '#326BE8', 
                    borderRadius: 8 
                }] 
            },
            options: { 
                responsive: true,
                plugins: { legend: { display: false } }, 
                scales: { 
                    y: { 
                        beginAtZero: true,
                        ticks: {
                            callback: function(value) { return '₱' + value; }
                        }
                    } 
                } 
            }
        });
    }

    @if (Model.TotalOrders > 0)
    {
        <text>
        var orderCanvas = document.getElementById('orderStatusChart');
        if (orderCanvas) {
            new Chart(orderCanvas, {
                type: 'doughnut',
                data: {
                    labels: ['Pending Pickup', 'Fulfilled in POS', 'Cancelled'],
                    datasets: [{
                        data: [@Model.PendingOrderCount, @Model.FulfilledOrderCount, @Model.CancelledOrderCount],
                        backgroundColor: ['#f59e0b', '#239B80', '#B91C2B'],
                        borderWidth: 2,
                        borderColor: '#ffffff'
                    }]
                },
                options: { 
                    responsive: true,
                    plugins: { 
                        legend: { position: 'bottom' } 
                    } 
                }
            });
        }
        </text>
    }
</script>
}
