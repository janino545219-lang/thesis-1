    <!-- RECENT TRANSACTIONS & LIVE INVENTORY MOVEMENTS -->
    <div class="row g-3">
        <!-- Recent Completed Sales -->
        <div class="col-12 col-lg-6">
            <div class="analytics-card p-3 h-100 shadow-sm" style="background: #fff; border-radius: 14px; border: 1px solid #E5E7EB;">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold text-navy mb-0">Recent Completed Sales</h6>
                    <a asp-controller="POS" asp-action="Index" class="small text-decoration-none">Open POS &rarr;</a>
                </div>
                @if (Model.RecentTransactions is null || Model.RecentTransactions.Count == 0)
                {
                    <p class="text-muted small py-3 mb-0">No completed sales recorded today.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Receipt #</th>
                                    <th>Branch</th>
                                    <th>Cashier</th>
                                    <th class="text-end">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var sale in Model.RecentTransactions)
                            {
                                <tr>
                                    <td><span class="badge bg-light text-navy border font-monospace">@sale.ReceiptNumber</span></td>
                                    <td>@sale.Branch.Name</td>
                                    <td class="small text-muted">@(sale.CashierUser?.FirstName ?? "Cashier")</td>
                                    <td class="text-end fw-bold text-navy">&#8369;@sale.TotalAmount.ToString("N2")</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <!-- Live Inventory Activity Audit Trail -->
        <div class="col-12 col-lg-6">
            <div class="analytics-card p-3 h-100 shadow-sm" style="background: #fff; border-radius: 14px; border: 1px solid #E5E7EB;">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold text-navy mb-0">Live Inventory Movements</h6>
                    <a asp-controller="Inventory" asp-action="Index" class="small text-decoration-none">All Inventory &rarr;</a>
                </div>
                @if (Model.RecentInventoryActivity is null || Model.RecentInventoryActivity.Count == 0)
                {
                    <p class="text-muted small py-3 mb-0">No recent inventory movements recorded.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th>Branch</th>
                                    <th>Type</th>
                                    <th class="text-end">Qty</th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var movement in Model.RecentInventoryActivity)
                            {
                                var typeBadge = movement.TransactionType switch
                                {
                                    InventoryTransactionType.Purchase => "bg-success text-white",
                                    InventoryTransactionType.Sale => "bg-info text-white",
                                    InventoryTransactionType.Damaged => "bg-danger text-white",
                                    InventoryTransactionType.Adjustment => "bg-warning text-dark",
                                    _ => "bg-secondary text-white"
                                };
                                <tr>
                                    <td class="fw-semibold text-navy">@movement.Product.Name</td>
                                    <td><span class="badge bg-light text-navy border">@movement.Branch.Name</span></td>
                                    <td><span class="badge @typeBadge">@movement.TransactionType</span></td>
                                    <td class="text-end fw-bold">@(movement.Quantity > 0 ? "+" + movement.Quantity : movement.Quantity)</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @if ((isAdmin || isBranchManager || isPharmacist) && Model.SalesTrend is not null && Model.SalesTrend.Count > 0)
    {
        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
        <script>
            (function () {
                'use strict';
                // 14-Day Sales Trend Line Chart
                var salesTrendLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SalesTrend.Select(p => p.Date.ToString("MM/dd"))));
                var salesTrendData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SalesTrend.Select(p => p.TotalAmount)));
                var salesCanvas = document.getElementById('dashboardSalesChart');
                if (salesCanvas) {
                    new Chart(salesCanvas, {
                        type: 'line',
                        data: {
                            labels: salesTrendLabels,
                            datasets: [{
                                label: 'Sales (\u20B1)',
                                data: salesTrendData,
                                borderColor: '@(isAdmin ? "#B91C2B" : isPharmacist ? "#059669" : "#1e40af")',
                                backgroundColor: '@(isAdmin ? "rgba(185, 28, 43, 0.08)" : isPharmacist ? "rgba(5, 150, 105, 0.08)" : "rgba(30, 64, 175, 0.08)")',
                                borderWidth: 2.5,
                                fill: true,
                                tension: 0.35,
                                pointBackgroundColor: '@(isAdmin ? "#B91C2B" : isPharmacist ? "#059669" : "#1e40af")',
                                pointRadius: 3
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: { display: false },
                                tooltip: {
                                    callbacks: {
                                        label: function(ctx) {
                                            return ' Sales: \u20B1' + Number(ctx.raw).toLocaleString('en-US', { minimumFractionDigits: 2 });
                                        }
                                    }
                                }
                            },
                            scales: {
                                y: {
                                    beginAtZero: true,
                                    grid: { color: 'rgba(0,0,0,0.05)' }
                                },
                                x: {
                                    grid: { display: false }
                                }
                            }
                        }
                    });
                }

                // Branch Comparison Bar Chart (Admin Only)
                @if (isAdmin && Model.SalesByBranch is not null && Model.SalesByBranch.Count > 0)
                {
                    <text>
                    var branchLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SalesByBranch.Select(p => p.BranchName)));
                    var branchData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SalesByBranch.Select(p => p.TotalAmount)));
                    var branchCanvas = document.getElementById('dashboardBranchChart');
                    if (branchCanvas) {
                        new Chart(branchCanvas, {
                            type: 'bar',
                            data: {
                                labels: branchLabels,
                                datasets: [{
                                    label: 'Branch Revenue (\u20B1)',
                                    data: branchData,
                                    backgroundColor: ['#1e40af', '#B91C2B', '#059669', '#d97706'],
                                    borderRadius: 6
                                }]
                            },
                            options: {
                                responsive: true,
                                maintainAspectRatio: false,
                                plugins: {
                                    legend: { display: false },
                                    tooltip: {
                                        callbacks: {
                                            label: function(ctx) {
                                                return ' Revenue: \u20B1' + Number(ctx.raw).toLocaleString('en-US', { minimumFractionDigits: 2 });
                                            }
                                        }
                                    }
                                },
                                scales: {
                                    y: {
                                        beginAtZero: true,
                                        grid: { color: 'rgba(0,0,0,0.05)' }
                                    },
                                    x: {
                                        grid: { display: false }
                                    }
                                }
                            }
                        });
                    }
                    </text>
                }
            })();
        </script>
    }
}
