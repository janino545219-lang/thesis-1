@using FarmaciaSmart.Web.Models.ViewModels.Home
@model StaffHomeViewModel
@{
    ViewData["Title"] = "Home";
}

@section Styles {
    <link rel="stylesheet" href="~/css/analytics.css" asp-append-version="true" />
}

<div class="analytics-page">
    <h2 class="mb-4">Welcome, @Model.DisplayName!</h2>

    @if (Model.BusinessOverview is not null)
    {
        <h6 class="text-muted mb-3">Business Overview <small>(this month)</small></h6>
        <div class="row g-3 mb-4">
            <div class="col-12 col-md-6 col-lg-3">
                <div class="stat-card-primary">
                    <div class="stat-label">Total Sales</div>
                    <div class="stat-value">@Model.BusinessOverview.TotalSalesThisMonth.ToString("N2")</div>
                    <a asp-controller="Analytics" asp-action="Index" class="text-decoration-none" style="color:rgba(255,255,255,0.85)">View full Analytics &rarr;</a>
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-3">
                <div class="stat-card">
                    <div class="stat-label">Transactions</div>
                    <div class="stat-value">@Model.BusinessOverview.TransactionsThisMonth</div>
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-3">
                <div class="stat-card">
                    <div class="stat-label">Avg Order Value</div>
                    <div class="stat-value">@Model.BusinessOverview.AvgOrderValueThisMonth.ToString("N2")</div>
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-3">
                <div class="stat-card">
                    <div class="stat-label">New Customers</div>
                    <div class="stat-value">@Model.BusinessOverview.NewCustomersThisMonth</div>
                </div>
            </div>
        </div>
    }

    <div class="row g-3">
        @if (Model.TodaysSalesCount.HasValue)
        {
            <div class="col-12 col-md-6 col-lg-3">
                <div class="analytics-card h-100">
                    <h6 class="mb-2">Today's Sales</h6>
                    <div class="stat-value mb-1">@Model.TodaysSalesTotal!.Value.ToString("N2")</div>
                    <p class="text-muted small mb-3">@Model.TodaysSalesCount transaction(s) today</p>
                    <a asp-controller="POS" asp-action="Index" class="btn btn-sm btn-primary">Go to POS</a>
                </div>
            </div>
        }
        @if (Model.LowStockCount.HasValue)
        {
            <div class="col-12 col-md-6 col-lg-3">
                <div class="analytics-card h-100">
                    <h6 class="mb-2">Inventory Alerts</h6>
                    <div class="stat-value mb-1">@Model.LowStockCount</div>
                    <p class="text-muted small mb-3">low stock &middot; @Model.ExpiringSoonCount expiring within 30 days</p>
                    <a asp-controller="Inventory" asp-action="Index" class="btn btn-sm btn-primary">Go to Inventory</a>
                </div>
            </div>
        }
        @if (Model.PendingReviewsCount.HasValue)
        {
            <div class="col-12 col-md-6 col-lg-3">
                <div class="analytics-card h-100">
                    <h6 class="mb-2">Pending Recommendation Reviews</h6>
                    <div class="stat-value mb-1">@Model.PendingReviewsCount</div>
                    <p class="text-muted small mb-3">awaiting pharmacist review</p>
                    <a asp-controller="RecommendationReview" asp-action="Index" class="btn btn-sm btn-primary">Review Now</a>
                </div>
            </div>
        }
        @if (Model.ClockedInTodayCount.HasValue)
        {
            <div class="col-12 col-md-6 col-lg-3">
                <div class="analytics-card h-100">
                    <h6 class="mb-2">HR &amp; Payroll</h6>
                    <div class="stat-value mb-1">@Model.ClockedInTodayCount</div>
                    <p class="text-muted small mb-3">clocked in today &middot; @Model.DraftPayrollCount draft payroll(s)</p>
                    <a asp-controller="Attendance" asp-action="Index" class="btn btn-sm btn-primary">Go to Attendance</a>
                </div>
            </div>
        }
    </div>
</div>
