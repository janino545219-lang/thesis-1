@using FarmaciaSmart.Web.Helpers
@using FarmaciaSmart.Web.Models.Entities
@using FarmaciaSmart.Web.Models.ViewModels.Home
@model StaffHomeViewModel
@{
    var isSuperAdmin = User.IsInRole(ApplicationRoles.SuperAdmin) || Model.IsSuperAdmin;
    var isAdmin = User.IsInRole(ApplicationRoles.Administrator) || isSuperAdmin;
    var isBranchManager = User.IsInRole(ApplicationRoles.BranchManager) && !isAdmin;
    var isPharmacist = (User.IsInRole(ApplicationRoles.Pharmacist) || Model.IsPharmacist) && !isAdmin && !isBranchManager;

    ViewData["Title"] = isSuperAdmin
        ? "Super Admin Dashboard - Farmacia San Antonio"
        : isAdmin 
            ? "Admin & Owner Dashboard - Farmacia San Antonio" 
            : isBranchManager
                ? $"Branch Manager Dashboard - {Model.AssignedBranchName ?? "Farmacia San Antonio"}"
                : isPharmacist
                    ? "Pharmacist Clinical & Operations Dashboard - Farmacia San Antonio"
                    : "Staff Operations Dashboard - Farmacia San Antonio";
}

@section Styles {
    <link rel="stylesheet" href="~/css/analytics.css" asp-append-version="true" />
    <style>
        .dashboard-header {
            background: linear-gradient(135deg, #ffffff 0%, #f9fafb 100%);
            border: 1px solid #E5E7EB;
            border-radius: 16px;
            padding: 1.75rem 2rem;
            margin-bottom: 1.5rem;
            box-shadow: 0 4px 20px rgba(23, 32, 51, 0.04);
        }
        .stat-card-custom {
            background: #ffffff;
            border: 1px solid #E5E7EB;
            border-radius: 14px;
            padding: 1.25rem 1.5rem;
            box-shadow: 0 2px 10px rgba(23, 32, 51, 0.03);
            height: 100%;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            transition: transform 0.15s, box-shadow 0.15s;
        }
        .stat-card-custom:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(23, 32, 51, 0.08);
        }
        .stat-card-custom.highlight-red {
            background: linear-gradient(135deg, #B91C2B 0%, #991b1b 100%);
            border-color: #B91C2B;
            color: #ffffff;
        }
        .stat-card-custom.highlight-blue {
            background: linear-gradient(135deg, #1e3a8a 0%, #1e40af 100%);
            border-color: #1e3a8a;
            color: #ffffff;
        }
        .stat-card-custom.highlight-purple {
            background: linear-gradient(135deg, #4f46e5 0%, #4338ca 100%);
            border-color: #4338ca;
            color: #ffffff;
        }
        .stat-card-custom.highlight-emerald {
            background: linear-gradient(135deg, #059669 0%, #047857 100%);
            border-color: #047857;
            color: #ffffff;
        }
        .stat-icon {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
        }
        .usecase-box {
            background: #ffffff;
            border: 1px solid #E5E7EB;
            border-radius: 14px;
            padding: 1.25rem 1.25rem;
            height: 100%;
            transition: all 0.2s;
        }
        .usecase-box:hover {
            border-color: #326BE8;
            box-shadow: 0 4px 16px rgba(50, 107, 232, 0.08);
        }
        .usecase-title {
            font-size: 0.95rem;
            font-weight: 700;
            color: #172033;
            margin-bottom: 0.25rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        .chart-box {
            background: #ffffff;
            border: 1px solid #E5E7EB;
            border-radius: 14px;
            padding: 1.25rem 1.5rem;
            box-shadow: 0 2px 10px rgba(23, 32, 51, 0.03);
        }
    </style>
}

<div class="analytics-page py-2">
    <!-- EXECUTIVE & MANAGER & PHARMACIST WELCOME HEADER -->
    <div class="dashboard-header d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-2">
                @if (isSuperAdmin)
                {
                    <span class="badge" style="background-color: #4f46e5; color: #fff; font-size: 0.8rem; padding: 0.35rem 0.65rem;">&#128081; Super Admin</span>
                    <span class="badge bg-light text-secondary border" style="font-size: 0.8rem;">Full System Governance</span>
                }
                else if (isAdmin)
                {
                    <span class="badge" style="background-color: #B91C2B; color: #fff; font-size: 0.8rem; padding: 0.35rem 0.65rem;">Administrator / Owner</span>
                    <span class="badge bg-light text-secondary border" style="font-size: 0.8rem;">Sta. Cruz, Davao del Sur</span>
                }
                else if (isBranchManager)
                {
                    <span class="badge bg-primary text-white" style="font-size: 0.8rem; padding: 0.35rem 0.65rem;">Branch Manager (Per Branch)</span>
                    <span class="badge bg-light text-primary border fw-bold" style="font-size: 0.8rem;">@(Model.AssignedBranchName ?? "Main Branch")</span>
                }
                else if (isPharmacist)
                {
                    <span class="badge text-white" style="background-color: #059669; font-size: 0.8rem; padding: 0.35rem 0.65rem;">&#128138; Licensed Pharmacist</span>
                    <span class="badge bg-light text-success border fw-bold" style="font-size: 0.8rem;">Clinical &amp; Dispensary Operations</span>
                }
                else
                {
                    <span class="badge bg-secondary text-white" style="font-size: 0.8rem;">Staff Portal</span>
                }
            </div>
            <h2 class="fw-bold mb-1 text-navy">
                @(isSuperAdmin ? "Super Admin Governance & Operations Dashboard" : isAdmin ? "Admin & Owner Management Dashboard" : isBranchManager ? "Branch Manager Operations Dashboard" : isPharmacist ? "Pharmacist Clinical & Operations Dashboard" : "Staff Operations Dashboard")
            </h2>
            <p class="text-secondary small mb-0">
                Welcome back, <strong>@Model.DisplayName</strong>! 
                @(isSuperAdmin
                    ? "Full system governance: User management, role provisioning, multi-branch oversight, audit logs, and unified sales operations."
                    : isBranchManager 
                        ? $"Branch-level monitoring, inventory control, and POS operations for {Model.AssignedBranchName ?? "your assigned branch"}." 
                        : isPharmacist
                            ? "Prescription dispensing, clinical AI review gating, cash flow & expense oversight, and product return recording (ACM Figure 5)."
                            : "Centralized multi-branch inventory synchronization, POS operations, and sales intelligence.")
            </p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            @if (isSuperAdmin)
            {
                <a asp-controller="User" asp-action="Index" class="btn text-white px-3 py-2 fw-semibold" style="background-color: #4f46e5; border-color: #4f46e5;">
                    <span>&#128101;</span> Manage Users &amp; Roles
                </a>
            }
            @if (isPharmacist)
            {
                <a asp-controller="POS" asp-action="Index" class="btn text-white px-3 py-2 fw-semibold" style="background-color: #059669; border-color: #059669;">
                    <span>&#128138;</span> Dispense Medicine (POS)
                </a>
                <a asp-controller="CustomerOrder" asp-action="Index" class="btn btn-outline-success px-3 py-2 fw-semibold">
                    <span>&#128221;</span> Verify Prescriptions
                    @if (Model.PendingOrdersCount.HasValue && Model.PendingOrdersCount > 0)
                    {
                        <span class="badge bg-success text-white ms-1">@Model.PendingOrdersCount</span>
                    }
                </a>
                <a asp-controller="RecommendationReview" asp-action="Index" class="btn btn-outline-primary px-3 py-2 fw-semibold">
                    <span>&#9989;</span> Clinical Reviews
                    @if (Model.PendingReviewsCount.HasValue && Model.PendingReviewsCount > 0)
                    {
                        <span class="badge bg-warning text-dark ms-1">@Model.PendingReviewsCount</span>
                    }
                </a>
            }
            else
            {
                <a asp-controller="POS" asp-action="Index" class="btn btn-action-blue px-3 py-2 fw-semibold">
                    <span>&#128181;</span> Launch POS Terminal
                </a>
                <a asp-controller="CustomerOrder" asp-action="Index" class="btn btn-outline-primary px-3 py-2 fw-semibold">
                    <span>&#128717;</span> Customer Pre-Orders
                    @if (Model.PendingOrdersCount.HasValue && Model.PendingOrdersCount > 0)
                    {
                        <span class="badge bg-warning text-dark ms-1">@Model.PendingOrdersCount</span>
                    }
                </a>
            }
            @if (isAdmin || isBranchManager || isPharmacist)
            {
                <a asp-controller="Analytics" asp-action="Index" class="btn btn-outline-secondary px-3 py-2 fw-semibold">
                    <span>&#128200;</span> Detailed Analytics
                </a>
            }
        </div>
    </div>

    @if (isSuperAdmin)
    {
        <!-- SUPER ADMIN GOVERNANCE KPI ROW (ACM Figure 5: Super Admin System Governance) -->
        <div class="row g-3 mb-4">
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="stat-card-custom highlight-purple">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="small fw-bold text-uppercase" style="color: rgba(255,255,255,0.85);">System Users &amp; Roles</span>
                        <span class="fs-5">&#128101;</span>
                    </div>
                    <div class="stat-value fs-2 fw-bold mb-1">@(Model.TotalUsersCount ?? 0)</div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="small" style="color: rgba(255,255,255,0.9);">Provisioned accounts</span>
                        <a asp-controller="User" asp-action="Index" class="badge bg-white text-dark text-decoration-none fw-semibold">Manage &rarr;</a>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="stat-card-custom">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="small fw-bold text-muted text-uppercase">Registered Customers</span>
                        <div class="stat-icon bg-info-subtle text-info">&#128100;</div>
                    </div>
                    <div class="stat-value fs-2 fw-bold text-navy mb-1">@(Model.TotalCustomersCount ?? 0)</div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="small text-muted">Customer portal profiles</span>
                        <a asp-controller="Customer" asp-action="Index" class="small fw-semibold text-primary text-decoration-none">View Customers &rarr;</a>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="stat-card-custom">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="small fw-bold text-muted text-uppercase">Audit Trail Events</span>
                        <div class="stat-icon bg-secondary-subtle text-secondary">&#128221;</div>
                    </div>
                    <div class="stat-value fs-2 fw-bold text-navy mb-1">@(Model.TotalAuditLogsTodayCount ?? 0)</div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="small text-muted">Recorded events today</span>
                        <a asp-controller="AuditLog" asp-action="Index" class="small fw-semibold text-primary text-decoration-none">Audit Trail &rarr;</a>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="stat-card-custom">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="small fw-bold text-muted text-uppercase">Operating Branches</span>
                        <div class="stat-icon bg-primary-subtle text-primary">&#127970;</div>
                    </div>
                    <div class="stat-value fs-2 fw-bold text-navy mb-1">@(Model.TotalBranchesCount ?? 0)</div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="small text-muted">Active branch nodes</span>
                        <a asp-controller="Branch" asp-action="Index" class="small fw-semibold text-primary text-decoration-none">Branches &rarr;</a>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- PRIMARY KPI SUMMARY METRICS -->
    <div class="row g-3 mb-4">
        @if (isAdmin && Model.BusinessOverview is not null)
        {
            <!-- Monthly Sales (Admin/Owner) -->
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="stat-card-custom highlight-red">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="small fw-bold text-uppercase" style="color: rgba(255,255,255,0.85);">Total Sales (This Month)</span>
                        <span class="fs-5">&#128181;</span>
                    </div>
                    <div class="stat-value fs-2 fw-bold mb-1">&#8369;@Model.BusinessOverview.TotalSalesThisMonth.ToString("N2")</div>
                    <div class="small" style="color: rgba(255,255,255,0.9);">
                        @if (Model.BusinessOverview.SalesPercentChange.HasValue)
                        {
                            <span>@(Model.BusinessOverview.SalesPercentChange >= 0 ? "+" : "")@Model.BusinessOverview.SalesPercentChange% vs last month</span>
                        }
                        else
                        {
                            <span>First recorded month</span>
                        }
                    </div>
                </div>
            </div>
        }
        else if (isBranchManager)
        {
            <!-- Branch Sales Highlight -->
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="stat-card-custom highlight-blue">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="small fw-bold text-uppercase" style="color: rgba(255,255,255,0.85);">Branch Today's Sales</span>
                        <span class="fs-5">&#128181;</span>
                    </div>
                    <div class="stat-value fs-2 fw-bold mb-1">&#8369;@(Model.TodaysSalesTotal?.ToString("N2") ?? "0.00")</div>
                    <div class="small" style="color: rgba(255,255,255,0.9);">
                        @(Model.TodaysSalesCount ?? 0) transaction(s) processed at this branch today
                    </div>
                </div>
            </div>
        }
        else if (isPharmacist)
        {
            <!-- Cash Inflow (Pharmacist) -->
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="stat-card-custom highlight-emerald">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="small fw-bold text-uppercase" style="color: rgba(255,255,255,0.85);">Cash Inflows (Today)</span>
                        <span class="fs-5">&#128181;</span>
                    </div>
                    <div class="stat-value fs-2 fw-bold mb-1">&#8369;@(Model.TodaysSalesTotal?.ToString("N2") ?? "0.00")</div>
                    <div class="small" style="color: rgba(255,255,255,0.9);">
                        @(Model.TodaysSalesCount ?? 0) sale transaction(s) processed
                    </div>
                </div>
            </div>

            <!-- Cash Outflow / Expenses (Pharmacist) -->
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="stat-card-custom">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="text-muted small fw-bold text-uppercase">Expenses / Outflows</span>
                        <div class="stat-icon bg-warning-subtle text-warning">&#128179;</div>
                    </div>
                    <div class="stat-value fs-2 fw-bold text-navy mb-1">&#8369;@(Model.TodaysExpensesTotal?.ToString("N2") ?? "0.00")</div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="small text-muted">Purchase orders &amp; supplies</span>
                        <a asp-controller="Purchase" asp-action="Index" class="small fw-semibold text-primary text-decoration-none">Purchases &rarr;</a>
                    </div>
                </div>
            </div>

            <!-- Net Cash Flow (Pharmacist) -->
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="stat-card-custom">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="text-muted small fw-bold text-uppercase">Net Cash Flow</span>
                        <div class="stat-icon bg-success-subtle text-success">&#128200;</div>
                    </div>
                    <div class="stat-value fs-2 fw-bold @((Model.TodaysNetCashFlow ?? 0) >= 0 ? "text-success" : "text-danger") mb-1">&#8369;@(Model.TodaysNetCashFlow?.ToString("N2") ?? "0.00")</div>
                    <div class="small text-muted">Liquidity balance (Inflow - Outflow - Returns)</div>
                </div>
            </div>

            <!-- Customer Returns (Pharmacist) -->
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="stat-card-custom">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="text-muted small fw-bold text-uppercase">Returns Recorded</span>
                        <div class="stat-icon bg-danger-subtle text-danger">&#128260;</div>
                    </div>
                    <div class="stat-value fs-2 fw-bold text-navy mb-1">@(Model.TodaysReturnsCount ?? 0)</div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="small text-muted">Customer returns today</span>
                        <a asp-controller="Inventory" asp-action="Returns" class="small fw-semibold text-danger text-decoration-none">Returns &rarr;</a>
                    </div>
                </div>
            </div>
        }

        <!-- Today's Sales (If Admin and not branch manager or pharmacist) -->
        @if (isAdmin && !isPharmacist && Model.TodaysSalesTotal.HasValue)
        {
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="stat-card-custom">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="text-muted small fw-bold text-uppercase">Today's Sales (All Branches)</span>
                        <div class="stat-icon" style="background: #eef2ff; color: #4338ca;">&#128179;</div>
                    </div>
                    <div class="stat-value fs-2 fw-bold text-navy mb-1">&#8369;@Model.TodaysSalesTotal.Value.ToString("N2")</div>
                    <div class="small text-muted">@Model.TodaysSalesCount transaction(s) processed today</div>
                </div>
            </div>
        }

        <!-- Catalog Items Available -->
        @if ((isAdmin || isBranchManager) && Model.TotalProductsCount.HasValue)
        {
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="stat-card-custom">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="text-muted small fw-bold text-uppercase">Catalog Items</span>
                        <div class="stat-icon" style="background: #edf2fd; color: #326BE8;">&#128137;</div>
                    </div>
                    <div class="stat-value fs-2 fw-bold text-navy mb-1">@Model.TotalProductsCount <span class="fs-6 text-muted fw-normal">Products</span></div>
                    <div class="small text-muted">Available in master catalog</div>
                </div>
            </div>
        }

        <!-- Low Stock Alert (Reorder Point R = D x L + S) -->
        @if (Model.LowStockCount.HasValue)
        {
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="stat-card-custom @(Model.LowStockCount > 0 ? "border-danger-subtle" : "")">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="text-muted small fw-bold text-uppercase">Low Stock (Reorder Point)</span>
                        <div class="stat-icon" style="background: #fee2e2; color: #dc2626;">&#9888;</div>
                    </div>
                    <div class="stat-value fs-2 fw-bold @(Model.LowStockCount > 0 ? "text-danger" : "text-navy") mb-1">@Model.LowStockCount</div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="small text-muted">At or below threshold R</span>
                        <a asp-controller="Inventory" asp-action="Index" class="small fw-semibold text-danger text-decoration-none">Inspect &rarr;</a>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- NOTIFICATION & OPERATIONAL RIBBON -->
    <div class="row g-3 mb-4">
        @if (Model.ExpiringSoonCount.HasValue)
        {
            <div class="col-12 col-md-4">
                <div class="card p-3 border-warning-subtle h-100 shadow-sm">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="badge bg-warning text-dark fw-bold">FEFO Expiry Alert</span>
                        <span class="text-muted small">Next 30 Days</span>
                    </div>
                    <div class="fs-3 fw-bold text-warning mb-1">@Model.ExpiringSoonCount <span class="fs-6 text-dark fw-normal">batch(es)</span></div>
                    <p class="text-muted small mb-3">Batches approaching expiration date. Rotate stock using FEFO rule.</p>
                    <a asp-controller="Inventory" asp-action="Index" class="btn btn-sm btn-outline-warning w-100">Review Expiring Batches</a>
                </div>
            </div>
        }

        @if ((isAdmin || isPharmacist) && Model.PendingReviewsCount.HasValue)
        {
            <div class="col-12 col-md-4">
                <div class="card p-3 border-primary-subtle h-100 shadow-sm">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="badge" style="background: #326BE8; color: #fff;">AI Clinical Oversight</span>
                        <span class="text-muted small">Pharmacist Gate</span>
                    </div>
                    <div class="fs-3 fw-bold text-navy mb-1">@Model.PendingReviewsCount <span class="fs-6 text-muted fw-normal">awaiting review</span></div>
                    <p class="text-muted small mb-3">AI OTC &amp; supplement recommendations requiring pharmacist sign-off.</p>
                    <a asp-controller="RecommendationReview" asp-action="Index" class="btn btn-sm btn-outline-primary w-100">Open Clinical Review Queue</a>
                </div>
            </div>
        }
        else if (isBranchManager && Model.PendingOrdersCount.HasValue)
        {
            <div class="col-12 col-md-4">
                <div class="card p-3 border-primary-subtle h-100 shadow-sm">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="badge bg-primary text-white">Branch Pre-Orders</span>
                        <span class="text-muted small">In-Store Pickup</span>
                    </div>
                    <div class="fs-3 fw-bold text-navy mb-1">@Model.PendingOrdersCount <span class="fs-6 text-muted fw-normal">ready for pickup</span></div>
                    <p class="text-muted small mb-3">Customer orders placed online awaiting branch fulfillment and POS checkout.</p>
                    <a asp-controller="CustomerOrder" asp-action="Index" class="btn btn-sm btn-outline-primary w-100">Fulfill Branch Pre-Orders</a>
                </div>
            </div>
        }

        @if (Model.ClockedInTodayCount.HasValue)
        {
            <div class="col-12 col-md-4">
                <div class="card p-3 border-success-subtle h-100 shadow-sm">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="badge bg-success text-white">Branch Staff Attendance</span>
                        <span class="text-muted small">Today</span>
                    </div>
                    <div class="fs-3 fw-bold text-navy mb-1">@Model.ClockedInTodayCount <span class="fs-6 text-muted fw-normal">employee(s) active</span></div>
                    <p class="text-muted small mb-3">Staff time-in records logged for today's operating shift.</p>
                    <a asp-controller="Attendance" asp-action="Index" class="btn btn-sm btn-outline-success w-100">View Branch Attendance Log</a>
                </div>
            </div>
        }
    </div>

    @if ((isAdmin || isBranchManager || isPharmacist) && Model.SalesTrend is not null && Model.SalesTrend.Count > 0)
    {
        <!-- SALES ANALYTICS VISUAL CHARTS (Chart.js - Section 2.1.5.1.8) -->
        <div class="row g-3 mb-4">
            <div class="col-12 @(isAdmin ? "col-lg-8" : "col-lg-7")">
                <div class="chart-box h-100">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <h6 class="fw-bold text-navy mb-0">Sales Revenue Trend (Last 14 Days)</h6>
                            <small class="text-muted">Real-time daily transaction totals from POS terminals</small>
                        </div>
                        <a asp-controller="Analytics" asp-action="Index" class="small fw-semibold text-decoration-none">Full Analytics &rarr;</a>
                    </div>
                    <div style="height: 240px;">
                        <canvas id="dashboardSalesChart"></canvas>
                    </div>
                </div>
            </div>
            @if (isAdmin)
            {
                <div class="col-12 col-lg-4">
                    <div class="chart-box h-100">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div>
                                <h6 class="fw-bold text-navy mb-0">Branch Sales Comparison</h6>
                                <small class="text-muted">Main Branch vs Second Branch</small>
                            </div>
                        </div>
                        <div style="height: 240px;">
                            <canvas id="dashboardBranchChart"></canvas>
                        </div>
                    </div>
                </div>
            }
            else if (isBranchManager || isPharmacist)
            {
                <div class="col-12 col-lg-5">
                    <div class="chart-box h-100">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div>
                                <h6 class="fw-bold text-navy mb-0">Top-Moving Products</h6>
                                <small class="text-muted">Highest sales volume items</small>
                            </div>
                            <a asp-controller="Report" asp-action="SalesSummary" class="small fw-semibold text-decoration-none">Report &rarr;</a>
                        </div>
                        @if (Model.TopProducts is not null && Model.TopProducts.Count > 0)
                        {
                            var maxTopQty = Model.TopProducts.Max(p => p.QuantitySold);
                            <div class="d-flex flex-column gap-2">
                                @foreach (var (p, idx) in Model.TopProducts.Select((p, i) => (p, i)))
                                {
                                    <div class="d-flex align-items-center justify-content-between gap-2">
                                        <div class="d-flex align-items-center gap-2 min-w-0 flex-fill">
                                            <span class="badge bg-light text-navy border">@(idx + 1)</span>
                                            <span class="small fw-semibold text-navy text-truncate">@p.ProductName</span>
                                        </div>
                                        <span class="badge bg-primary-subtle text-primary fw-bold">@p.QuantitySold sold</span>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-muted small py-3 mb-0">No product sales recorded yet.</p>
                        }
                    </div>
                </div>
            }
        </div>
    }

