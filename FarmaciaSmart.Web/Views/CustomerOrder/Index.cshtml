@using FarmaciaSmart.Web.Models.Entities
@model List<CustomerOrder>
@{
    ViewData["Title"] = "Customer Pre-Orders";
}

<h2>Customer Pre-Orders (Pending Pickup)</h2>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

@if (Model.Count == 0)
{
    <p class="text-muted">No pending customer orders.</p>
}
else
{
    <div class="table-responsive">
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Order #</th>
                <th>Customer</th>
                <th>Branch</th>
                <th>Items</th>
                <th>Total</th>
                <th>Placed</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var order in Model)
        {
            <tr>
                <td>@order.OrderNumber</td>
                <td>@order.Customer.User.FirstName @order.Customer.User.LastName</td>
                <td>@order.Branch.Name</td>
                <td>@order.Items.Sum(i => i.Quantity)</td>
                <td>@order.TotalAmount.ToString("N2")</td>
                <td>@order.CreatedAt.ToString("g")</td>
                <td><a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-secondary">View</a></td>
            </tr>
        }
        </tbody>
    </table>
    </div>
}
