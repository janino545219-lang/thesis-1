@using FarmaciaSmart.Web.Helpers
@model FarmaciaSmart.Web.Models.ViewModels.Account.LoginViewModel
@{
    ViewData["Title"] = "Staff Login - Farmacia San Antonio";
    Layout = "_AuthLayout";
}

<div class="auth-card">
    <!-- LEFT SIDE: Pharmacy Visual & Feature Highlights -->
    <div class="auth-visual">
        <div class="auth-brand-badge">
            <partial name="_Logo" view-data='@(new ViewDataDictionary(ViewData) { { "variant", "full" }, { "height", 36 }, { "href", "/" } })' />
        </div>
        <div class="auth-visual-content">
            <h2 class="auth-visual-heading">Staff Operations Portal</h2>
            <ul class="auth-feature-list">
                <li class="auth-feature-item">
                    <span class="auth-feature-icon">&#10003;</span>
                    <span>Point of Sale &amp; transactions</span>
                </li>
                <li class="auth-feature-item">
                    <span class="auth-feature-icon">&#10003;</span>
                    <span>Multi-branch inventory control</span>
                </li>
                <li class="auth-feature-item">
                    <span class="auth-feature-icon">&#10003;</span>
                    <span>Prescription &amp; clinical reviews</span>
                </li>
                <li class="auth-feature-item">
                    <span class="auth-feature-icon">&#10003;</span>
                    <span>Secure role-based access</span>
                </li>
            </ul>
            <div class="auth-visual-tagline">
                Staff Operations Portal &middot; Point of Sale &middot; Clinical Reviews
            </div>
        </div>
    </div>

    <!-- RIGHT SIDE: Staff Login Form Only (No Public Sign Up) -->
    <div class="auth-form-side">
        <!-- Account-Type Selector -->
        <div class="auth-audience-switch" role="group" aria-label="Account Type">
            <a class="auth-audience-pill" asp-area="CustomerPortal" asp-controller="Account" asp-action="Login">Customer</a>
            <span class="auth-audience-pill active">Staff</span>
        </div>

        @if (TempData["Success"] is string successMsg)
        {
            <div class="alert alert-success auth-alert d-flex align-items-center gap-2 mb-3" role="alert">
                <span>&#10003;</span>
                <span>@successMsg</span>
            </div>
        }

        <div class="auth-heading">
            <h2>Staff Sign In</h2>
            <p>Sign in with your authorized staff credentials to continue.</p>
        </div>

        <div asp-validation-summary="ModelOnly" class="alert alert-danger auth-alert" role="alert"></div>

        <form asp-controller="Account" asp-action="Login" method="post" id="staffLoginForm" novalidate>
            <input type="hidden" asp-for="ReturnUrl" />
            
            <div class="mb-3">
                <label asp-for="Email" class="form-label">Work Email Address</label>
                <input asp-for="Email" 
                       type="email"
                       class="form-control" 
                       id="staffLoginEmailInput"
                       autocomplete="username" 
                       placeholder="staff@farmaciasanantonio.ph" 
                       required />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label">Password</label>
                <div class="auth-password-wrapper">
                    <input asp-for="Password" 
                           type="password" 
                           class="form-control" 
                           id="staffPasswordInput"
                           autocomplete="current-password" 
                           placeholder="Enter your password" 
                           required />
                    <button type="button" 
                            class="btn-toggle-password" 
                            id="toggleStaffPasswordBtn" 
                            aria-label="Toggle password visibility">
                        <partial name="_LandingIcon" view-data='@(new ViewDataDictionary(ViewData) { { "icon", "eye" } })' />
                    </button>
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-4">
                <div class="form-check mb-0">
                    <input asp-for="RememberMe" class="form-check-input" id="staffRememberMe" />
                    <label asp-for="RememberMe" class="form-check-label small" for="staffRememberMe">Remember me</label>
                </div>
            </div>

            <button type="submit" class="btn auth-submit-btn w-100" id="staffLoginSubmitBtn">
                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                <span class="btn-text">Staff Sign In</span>
            </button>
        </form>

        <div class="alert alert-light border small text-muted mt-4 mb-0 text-center">
            <span class="fw-semibold d-block text-dark mb-1">Authorized Access Only</span>
            Staff accounts are provisioned exclusively by the Pharmacy Owner / Administrator. If you require credentials, please contact management.
        </div>

        <p class="auth-footer-link mt-3 mb-0">
            Customer looking to place pre-orders?
            <a asp-area="CustomerPortal" asp-controller="Account" asp-action="Login">Go to Customer Login</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            'use strict';

            // Password visibility toggle
            var btnToggle = document.getElementById('toggleStaffPasswordBtn');
            var passwordInput = document.getElementById('staffPasswordInput');
            if (btnToggle && passwordInput) {
                btnToggle.addEventListener('click', function () {
                    var isPassword = passwordInput.getAttribute('type') === 'password';
                    passwordInput.setAttribute('type', isPassword ? 'text' : 'password');
                });
            }

            // Submit loading spinner
            var form = document.getElementById('staffLoginForm');
            var submitBtn = document.getElementById('staffLoginSubmitBtn');
            if (form && submitBtn) {
                form.addEventListener('submit', function () {
                    if (form.checkValidity && !form.checkValidity()) {
                        return;
                    }
                    submitBtn.classList.add('is-submitting');
                    submitBtn.setAttribute('disabled', 'disabled');
                });
            }
        })();
    </script>
}
