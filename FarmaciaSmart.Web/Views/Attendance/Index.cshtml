@model List<Attendance>
@{
    ViewData["Title"] = "Attendance";
    var employees = ViewBag.Employees as List<Employee> ?? [];
    var byEmployee = Model.ToDictionary(a => a.EmployeeId);
}

<h2>Attendance &mdash; @DateTime.Today.ToString("D")</h2>

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<p><a asp-action="History" class="btn btn-outline-secondary">View History</a></p>

<div class="table-responsive">
<table class="table table-bordered">
    <thead>
        <tr>
            <th>Employee</th>
            <th>Time In</th>
            <th>Time Out</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var emp in employees)
    {
        byEmployee.TryGetValue(emp.Id, out var record);
        <tr>
            <td>@emp.FirstName @emp.LastName</td>
            <td>@(record?.TimeIn?.ToString("t") ?? "-")</td>
            <td>@(record?.TimeOut?.ToString("t") ?? "-")</td>
            <td>
                @if (record?.TimeIn is null)
                {
                    <form asp-action="ClockIn" method="post" class="d-inline">
                        <input type="hidden" name="employeeId" value="@emp.Id" />
                        <button type="submit" class="btn btn-sm btn-success">Clock In</button>
                    </form>
                }
                else if (record.TimeOut is null)
                {
                    <form asp-action="ClockOut" method="post" class="d-inline">
                        <input type="hidden" name="employeeId" value="@emp.Id" />
                        <button type="submit" class="btn btn-sm btn-warning">Clock Out</button>
                    </form>
                }
                else
                {
                    <span class="badge bg-secondary">Done</span>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
</div>
