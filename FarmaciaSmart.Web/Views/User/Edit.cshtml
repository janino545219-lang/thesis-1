@using FarmaciaSmart.Web.Helpers
@model FarmaciaSmart.Web.Models.ViewModels.Users.EditUserViewModel
@{
    ViewData["Title"] = $"Edit User - {Model.Email}";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="badge bg-primary text-uppercase px-2 py-1">Super Admin &middot; Security</span>
            <span class="text-muted small">ACM Use Case: Manage Users &amp; Roles</span>
        </div>
        <h2 class="fw-bold text-navy mb-0">Edit User Role &amp; Access</h2>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">&larr; Back to Users</a>
</div>

<div class="card p-4 border-0 shadow-sm" style="max-width: 760px; border-radius: 14px; background: #ffffff;">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert"></div>

    <form asp-action="Edit" method="post" id="editUserForm" novalidate>
        <input type="hidden" asp-for="Id" />

        <div class="row g-3">
            <div class="col-12 col-md-6">
                <label asp-for="FirstName" class="form-label fw-semibold">First Name <span class="text-danger">*</span></label>
                <input asp-for="FirstName" class="form-control" required />
                <span asp-validation-for="FirstName" class="text-danger small"></span>
            </div>
            <div class="col-12 col-md-6">
                <label asp-for="LastName" class="form-label fw-semibold">Last Name <span class="text-danger">*</span></label>
                <input asp-for="LastName" class="form-control" required />
                <span asp-validation-for="LastName" class="text-danger small"></span>
            </div>
        </div>

        <div class="row g-3 mt-1">
            <div class="col-12 col-md-6">
                <label asp-for="Email" class="form-label fw-semibold">Email / Login Username</label>
                <input asp-for="Email" type="email" class="form-control bg-light" readonly />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <div class="col-12 col-md-6">
                <label asp-for="PhoneNumber" class="form-label fw-semibold">Contact Number</label>
                <input asp-for="PhoneNumber" class="form-control" />
                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
            </div>
        </div>

        <div class="row g-3 mt-1">
            <div class="col-12 col-md-6">
                <label asp-for="Role" class="form-label fw-semibold">Assigned System Role <span class="text-danger">*</span></label>
                <select asp-for="Role" class="form-select" required>
                    <option value="@ApplicationRoles.Cashier">Cashier (Point of Sale)</option>
                    <option value="@ApplicationRoles.Pharmacist">Pharmacist (Prescriptions &amp; Clinical)</option>
                    <option value="@ApplicationRoles.BranchManager">Branch Manager (Per Branch)</option>
                    <option value="@ApplicationRoles.InventoryStaff">Inventory Staff (Batches &amp; Transfers)</option>
                    <option value="@ApplicationRoles.HrPayroll">HR &amp; Payroll Staff</option>
                    <option value="@ApplicationRoles.Administrator">Administrator / Owner (Full Operations)</option>
                    <option value="@ApplicationRoles.SuperAdmin">Super Admin (System Governance)</option>
                </select>
                <span asp-validation-for="Role" class="text-danger small"></span>
            </div>
            <div class="col-12 col-md-6">
                <label asp-for="BranchId" class="form-label fw-semibold">Assigned Branch</label>
                <select asp-for="BranchId" class="form-select">
                    <option value="">-- Global / Multi-Branch --</option>
                    @foreach (var b in Model.Branches)
                    {
                        <option value="@b.Id" selected="@(Model.BranchId == b.Id)">@b.Name</option>
                    }
                </select>
                <span asp-validation-for="BranchId" class="text-danger small"></span>
            </div>
        </div>

        <div class="form-check form-switch my-3">
            <input asp-for="IsActive" class="form-check-input" type="checkbox" id="isActiveSwitch" />
            <label asp-for="IsActive" class="form-check-label fw-semibold" for="isActiveSwitch">
                Account Active (uncheck to suspend user access)
            </label>
        </div>

        <div class="card p-3 my-3 bg-light border">
            <h6 class="fw-bold text-navy mb-2">&#128272; Reset Password (Optional)</h6>
            <div class="col-12 col-md-8">
                <label asp-for="NewPassword" class="form-label small fw-semibold">New Password</label>
                <input asp-for="NewPassword" type="password" class="form-control" placeholder="Leave empty to keep existing password" />
                <span asp-validation-for="NewPassword" class="text-danger small"></span>
            </div>
        </div>

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary px-4 fw-semibold">Save Changes</button>
            <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
