@using FarmaciaSmart.Web.Helpers
@model FarmaciaSmart.Web.Models.ViewModels.Users.CreateUserViewModel
@{
    ViewData["Title"] = "Provision New User - Farmacia San Antonio";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="badge bg-primary text-uppercase px-2 py-1">Super Admin &middot; Security</span>
            <span class="text-muted small">ACM Use Case: Manage Users &amp; Roles</span>
        </div>
        <h2 class="fw-bold text-navy mb-0">Provision New User Account</h2>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">&larr; Back to Users</a>
</div>

<div class="card p-4 border-0 shadow-sm" style="max-width: 760px; border-radius: 14px; background: #ffffff;">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert"></div>

    <form asp-action="Create" method="post" id="createUserForm" novalidate>
        <div class="row g-3">
            <div class="col-12 col-md-6">
                <label asp-for="FirstName" class="form-label fw-semibold">First Name <span class="text-danger">*</span></label>
                <input asp-for="FirstName" class="form-control" placeholder="Juan" required />
                <span asp-validation-for="FirstName" class="text-danger small"></span>
            </div>
            <div class="col-12 col-md-6">
                <label asp-for="LastName" class="form-label fw-semibold">Last Name <span class="text-danger">*</span></label>
                <input asp-for="LastName" class="form-control" placeholder="Dela Cruz" required />
                <span asp-validation-for="LastName" class="text-danger small"></span>
            </div>
        </div>

        <div class="row g-3 mt-1">
            <div class="col-12 col-md-6">
                <label asp-for="Email" class="form-label fw-semibold">Work Email / Login Username <span class="text-danger">*</span></label>
                <input asp-for="Email" type="email" class="form-control" placeholder="juan.delacruz@farmaciasanantonio.ph" required />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <div class="col-12 col-md-6">
                <label asp-for="PhoneNumber" class="form-label fw-semibold">Contact Number</label>
                <input asp-for="PhoneNumber" class="form-control" placeholder="+63 912 345 6789" />
                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
            </div>
        </div>

        <div class="row g-3 mt-1">
            <div class="col-12 col-md-6">
                <label asp-for="Role" class="form-label fw-semibold">Assigned System Role <span class="text-danger">*</span></label>
                <select asp-for="Role" class="form-select" required>
                    <option value="@ApplicationRoles.Cashier">Cashier (Point of Sale)</option>
                    <option value="@ApplicationRoles.Pharmacist">Pharmacist (Prescriptions &amp; Clinical)</option>
                    <option value="@ApplicationRoles.BranchManager">Branch Manager (Per Branch)</option>
                    <option value="@ApplicationRoles.InventoryStaff">Inventory Staff (Batches &amp; Transfers)</option>
                    <option value="@ApplicationRoles.HrPayroll">HR &amp; Payroll Staff</option>
                    <option value="@ApplicationRoles.Administrator">Administrator / Owner (Full Operations)</option>
                    <option value="@ApplicationRoles.SuperAdmin">Super Admin (System Governance)</option>
                </select>
                <span asp-validation-for="Role" class="text-danger small"></span>
            </div>
            <div class="col-12 col-md-6">
                <label asp-for="BranchId" class="form-label fw-semibold">Assigned Branch</label>
                <select asp-for="BranchId" class="form-select">
                    <option value="">-- Global / Multi-Branch --</option>
                    @foreach (var b in Model.Branches)
                    {
                        <option value="@b.Id">@b.Name</option>
                    }
                </select>
                <span asp-validation-for="BranchId" class="text-danger small"></span>
            </div>
        </div>

        <div class="row g-3 my-2">
            <div class="col-12 col-md-6">
                <label asp-for="Password" class="form-label fw-semibold">Initial Password <span class="text-danger">*</span></label>
                <input asp-for="Password" type="password" class="form-control" placeholder="Min. 6 chars (e.g. Staff123!)" required />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>
            <div class="col-12 col-md-6">
                <label asp-for="ConfirmPassword" class="form-label fw-semibold">Confirm Password <span class="text-danger">*</span></label>
                <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Re-enter password" required />
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>
        </div>

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary px-4 fw-semibold">Create &amp; Provision User</button>
            <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
