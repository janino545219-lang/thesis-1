@model Recommendation
@{
    ViewData["Title"] = $"Review Recommendation #{Model.Id} - Farmacia San Antonio";
}

<div class="py-2">
    <!-- Breadcrumb & Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-action="Index">Review Queue</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Recommendation #@Model.Id</li>
                </ol>
            </nav>
            <h2 class="fw-bold mb-0 text-navy">Clinical Review: Recommendation #@Model.Id</h2>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                &larr; Back to Queue
            </a>
        </div>
    </div>

    <!-- Request Details Overview Card -->
    <div class="card p-4 mb-4 shadow-sm">
        <div class="row g-3">
            <div class="col-12 col-md-3">
                <div class="text-muted small text-uppercase fw-bold">Customer</div>
                <div class="fw-bold text-navy fs-6">@Model.Customer.User.FirstName @Model.Customer.User.LastName</div>
                <div class="text-muted small">@Model.Customer.User.Email</div>
            </div>
            <div class="col-12 col-md-3">
                <div class="text-muted small text-uppercase fw-bold">Target Category</div>
                <div class="fw-bold text-navy fs-6">@Model.Category.Name</div>
                <div class="text-muted small">OTC &amp; Supplements only</div>
            </div>
            <div class="col-12 col-md-3">
                <div class="text-muted small text-uppercase fw-bold">Request Timestamp</div>
                <div class="fw-bold text-navy fs-6">@Model.CreatedAt.ToString("MMM d, yyyy")</div>
                <div class="text-muted small">@Model.CreatedAt.ToString("hh:mm tt UTC")</div>
            </div>
            <div class="col-12 col-md-3">
                <div class="text-muted small text-uppercase fw-bold">Review Status</div>
                <div class="mt-1">
                    @{
                        var statusBadge = Model.ReviewStatus switch
                        {
                            RecommendationReviewStatus.Approved => "bg-success text-white",
                            RecommendationReviewStatus.Modified => "bg-info text-white",
                            RecommendationReviewStatus.Rejected => "bg-danger text-white",
                            _ => "bg-warning text-dark"
                        };
                    }
                    <span class="badge @statusBadge fs-6">@Model.ReviewStatus</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Candidates Table -->
    <div class="card p-0 overflow-hidden mb-4 shadow-sm">
        <div class="p-3 bg-light border-bottom">
            <h6 class="fw-bold text-navy mb-0">AI-Generated Product Candidates &amp; Clinical Explanations</h6>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 70px;">Rank</th>
                        <th>Product</th>
                        <th>Match Score</th>
                        <th>Clinical Explanation</th>
                        <th>Warnings / Contraindications</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model.Items.OrderBy(i => i.Rank))
                {
                    <tr>
                        <td>
                            <span class="badge bg-secondary">#@item.Rank</span>
                        </td>
                        <td>
                            <div class="fw-bold text-navy">@item.Product.Name</div>
                            <div class="text-muted small">@(item.Product.Brand ?? "Generic") &middot; &#8369;@item.Product.Price.ToString("N2")</div>
                        </td>
                        <td>
                            <div class="fw-semibold text-navy">@item.Score.ToString("F2")</div>
                        </td>
                        <td>
                            <p class="small mb-0 text-secondary">@item.Explanation</p>
                        </td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(item.Warning))
                            {
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle p-2 text-wrap">
                                    &#9888; @item.Warning
                                </span>
                            }
                            else
                            {
                                <span class="text-muted small">None recorded</span>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Review Form or Audit Trail -->
    @if (Model.ReviewStatus == RecommendationReviewStatus.PendingReview)
    {
        <div class="card p-4 shadow-sm border-primary" style="background: #fafcfe;">
            <h5 class="fw-bold text-navy mb-3">Pharmacist Clinical Determination</h5>
            <form asp-action="Review" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />

                <div class="mb-3">
                    <label class="form-label fw-bold text-navy">Decision</label>
                    <select name="status" class="form-select" required>
                        <option value="@((int)RecommendationReviewStatus.Approved)">Approve — Recommendation is safe and appropriate for customer pickup</option>
                        <option value="@((int)RecommendationReviewStatus.Modified)">Modified — Approved with pharmacist clinical notes / counseling required</option>
                        <option value="@((int)RecommendationReviewStatus.Rejected)">Reject — Unsuitable or contraindication identified</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold text-navy">Clinical Notes &amp; Audit Comments</label>
                    <textarea name="notes" class="form-control" rows="3" placeholder="Enter clinical evaluation rationale, counseling recommendations, or reason for modification/rejection..."></textarea>
                    <div class="form-text small">These notes are permanently logged in the audit trail.</div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-action-blue px-4 py-2 fw-semibold">
                        Submit Determination
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary px-3 py-2">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    }
    else
    {
        <div class="card p-4 bg-light shadow-sm">
            <h6 class="fw-bold text-navy mb-2">Audit Trail Record</h6>
            <div class="row g-3">
                <div class="col-12 col-md-4">
                    <span class="text-muted small">Reviewed By:</span>
                    <div class="fw-semibold text-navy">@(Model.ReviewedByUser?.FirstName ?? "Staff Pharmacist") @Model.ReviewedByUser?.LastName</div>
                </div>
                <div class="col-12 col-md-4">
                    <span class="text-muted small">Reviewed At:</span>
                    <div class="fw-semibold text-navy">@(Model.ReviewedAt?.ToString("MMM d, yyyy hh:mm tt UTC") ?? "N/A")</div>
                </div>
                <div class="col-12 col-md-4">
                    <span class="text-muted small">Clinical Notes:</span>
                    <div class="text-secondary small">@(string.IsNullOrWhiteSpace(Model.ReviewNotes) ? "No notes recorded" : Model.ReviewNotes)</div>
                </div>
            </div>
        </div>
    }
</div>
