@using FarmaciaSmart.Web.Models.Entities
@model List<PurchaseOrder>
@{
    ViewData["Title"] = "Purchases Report";
    var branches = ViewBag.Branches as List<Branch> ?? [];
    var suppliers = ViewBag.Suppliers as List<Supplier> ?? [];
}

<h2>Purchases Report</h2>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="date" name="from" value="@ViewBag.From" class="form-control" placeholder="From" />
    </div>
    <div class="col-auto">
        <input type="date" name="to" value="@ViewBag.To" class="form-control" placeholder="To" />
    </div>
    <div class="col-auto">
        <select name="branchId" class="form-select">
            <option value="">All Branches</option>
            @foreach (var branch in branches)
            {
                <option value="@branch.Id" selected="@(ViewBag.BranchId != null && (int)ViewBag.BranchId == branch.Id)">@branch.Name</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <select name="supplierId" class="form-select">
            <option value="">All Suppliers</option>
            @foreach (var supplier in suppliers)
            {
                <option value="@supplier.Id" selected="@(ViewBag.SupplierId != null && (int)ViewBag.SupplierId == supplier.Id)">@supplier.Name</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Filter</button>
    </div>
</form>

<p><strong>Total: @(((decimal)ViewBag.TotalAmount).ToString("N2"))</strong> (@Model.Count purchase order(s))</p>

<div class="table-responsive">
<table class="table table-bordered">
    <thead>
        <tr>
            <th>Order #</th>
            <th>Date</th>
            <th>Supplier</th>
            <th>Branch</th>
            <th>Status</th>
            <th>Total</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var order in Model)
    {
        <tr>
            <td><a asp-controller="Purchase" asp-action="Details" asp-route-id="@order.Id">@order.OrderNumber</a></td>
            <td>@order.CreatedAt.ToString("g")</td>
            <td>@order.Supplier.Name</td>
            <td>@order.Branch.Name</td>
            <td>@order.Status</td>
            <td>@order.TotalAmount.ToString("N2")</td>
        </tr>
    }
    </tbody>
</table>
</div>
