@model List<Sale>
@{
    ViewData["Title"] = "Sales Summary Report";
    var branches = ViewBag.Branches as List<Branch> ?? [];
}

<h2>Sales Summary Report</h2>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="date" name="from" value="@ViewBag.From" class="form-control" placeholder="From" />
    </div>
    <div class="col-auto">
        <input type="date" name="to" value="@ViewBag.To" class="form-control" placeholder="To" />
    </div>
    <div class="col-auto">
        <select name="branchId" class="form-select">
            <option value="">All Branches</option>
            @foreach (var branch in branches)
            {
                <option value="@branch.Id" selected="@(ViewBag.BranchId != null && (int)ViewBag.BranchId == branch.Id)">@branch.Name</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Filter</button>
    </div>
</form>

<p><strong>Total Sales: @(((decimal)ViewBag.TotalSales).ToString("N2"))</strong> (@Model.Count transaction(s))</p>

<div class="table-responsive">
<table class="table table-bordered">
    <thead>
        <tr>
            <th>Receipt #</th>
            <th>Date</th>
            <th>Branch</th>
            <th>Cashier</th>
            <th>Subtotal</th>
            <th>Discount</th>
            <th>Total</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var sale in Model)
    {
        <tr>
            <td>@sale.ReceiptNumber</td>
            <td>@sale.SaleDate.ToString("g")</td>
            <td>@sale.Branch.Name</td>
            <td>@sale.CashierUser.Email</td>
            <td>@sale.SubTotal.ToString("N2")</td>
            <td>@sale.DiscountAmount.ToString("N2")</td>
            <td>@sale.TotalAmount.ToString("N2")</td>
        </tr>
    }
    </tbody>
</table>
</div>
