@* Hero section with professional pharmacy photo, floating cards, headline, and CTAs *@

<section class="landing-hero" aria-label="Hero">
    <div class="landing-hero-text landing-animate landing-animate-1">
        <div class="landing-hero-pill mb-3">
            <span class="hero-pill-badge">Healthcare Platform</span>
            <span class="hero-pill-text">Farmacia San Antonio</span>
        </div>
        <h1>Your Trusted Pharmacy, Made Smarter.</h1>
        <p class="landing-animate landing-animate-2">
            Discover pharmacy products, explore pharmacist-reviewed recommendations, and conveniently preorder medicines for pickup at your preferred branch.
        </p>
        <div class="landing-hero-ctas landing-animate landing-animate-3">
            <a class="btn-landing-cta" asp-area="CustomerPortal" asp-controller="Account" asp-action="Register">
                Get Started
            </a>
            <a class="btn-landing-staff-link" asp-controller="Account" asp-action="Login">
                Staff Sign In &rarr;
            </a>
        </div>
    </div>

    <div class="landing-hero-image-wrap landing-animate landing-animate-4">
        <img src="/images/farmacia-san-antonio-store.jpg"
             alt="Farmacia San Antonio pharmacy counter - Friendly service and care for your wellness"
             width="600"
             height="450"
             fetchpriority="high"
             loading="eager"
             class="landing-hero-img" />

        <div class="landing-float-card landing-float-badge" aria-hidden="true">
            <partial name="_LandingIcon" view-data='@(new ViewDataDictionary(ViewData) { { "icon", "shield-check" } })' />
            <span>Pharmacist Reviewed</span>
        </div>

        <div class="landing-float-card landing-float-stock" aria-hidden="true">
            <partial name="_LandingIcon" view-data='@(new ViewDataDictionary(ViewData) { { "icon", "check-circle" } })' />
            <span>Branch Availability</span>
        </div>

        <div class="landing-float-card landing-float-suggestion" aria-hidden="true">
            <strong>Headache &amp; Fever?</strong>
            <span>Paracetamol 500 mg</span>
            <small>Pharmacist-verified OTC guidance</small>
        </div>
    </div>
</section>
