@using System.Security.Claims
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    var givenName = User.FindFirstValue(ClaimTypes.GivenName) ?? User.Identity?.Name ?? "there";
}

<!-- Floating Chatbot Trigger Button -->
<button type="button" class="farmacia-chatbot-fab" id="farmaciaChatbotFab" aria-label="Open AI Pharmacist Assistant">
    <div class="fab-pulse-dot"></div>
    <span class="fab-icon">&#129502;</span>
    <span class="fab-label">Ask AI Assistant</span>
</button>

<!-- Backdrop overlay -->
<div class="farmacia-chatbot-backdrop" id="farmaciaChatbotBackdrop"></div>

<!-- Slide-out Chatbot Panel -->
<div class="farmacia-chatbot-drawer" id="farmaciaChatbotDrawer" role="dialog" aria-modal="true" aria-label="Farmacia AI Assistant">
    <!-- Header -->
    <div class="chatbot-header">
        <div class="d-flex align-items-center gap-2">
            <div class="chatbot-avatar">
                <span>&#129502;</span>
                <span class="online-indicator"></span>
            </div>
            <div>
                <h6 class="mb-0 fw-bold chatbot-title">Farmacia AI Assistant</h6>
                <small class="chatbot-subtitle">Pharmacist-Reviewed OTC Guidance</small>
            </div>
        </div>
        <div class="d-flex align-items-center gap-1">
            <button type="button" class="btn btn-sm btn-chatbot-tool" id="farmaciaChatbotResetBtn" title="Restart conversation">
                <span>&#8635;</span>
            </button>
            <button type="button" class="btn btn-sm btn-chatbot-close" id="farmaciaChatbotCloseBtn" aria-label="Close chatbot">
                &times;
            </button>
        </div>
    </div>

    <!-- Clinical Disclaimer Notice -->
    <div class="chatbot-disclaimer">
        <span>&#9888;</span>
        <span>Preliminary OTC suggestions based on pharmacist-approved guidance. Does not replace professional medical advice.</span>
    </div>

    <!-- Scrollable Chat Messages Container -->
    <div class="chatbot-messages" id="farmaciaChatMessages">
        <!-- Messages will be injected dynamically -->
    </div>

    <!-- Quick Suggestions Bar -->
    <div class="chatbot-quick-bar" id="farmaciaQuickCategories">
        <!-- Category chips dynamically populated -->
    </div>

    <!-- Chat Input Area -->
    <div class="chatbot-input-container">
        <form id="farmaciaChatForm" class="d-flex gap-2 align-items-center mb-0">
            <input type="text" 
                   id="farmaciaChatInput" 
                   class="form-control chatbot-input" 
                   placeholder="Describe symptoms or ask (e.g. cough, fever)..." 
                   autocomplete="off" />
            <button type="submit" class="btn chatbot-send-btn" id="farmaciaChatSendBtn" aria-label="Send message">
                <span>&#10148;</span>
            </button>
        </form>
    </div>
</div>

<style>
/* ============================================================
   Farmacia Chatbot Drawer & FAB Styles
   ============================================================ */
.farmacia-chatbot-fab {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 1040;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    background: linear-gradient(135deg, #B91C2B 0%, #8E1522 100%);
    color: #ffffff;
    border: none;
    border-radius: 9999px;
    box-shadow: 0 8px 24px rgba(185, 28, 43, 0.35);
    cursor: pointer;
    font-weight: 600;
    font-size: 0.92rem;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
}
.farmacia-chatbot-fab:hover {
    transform: translateY(-3px) scale(1.02);
    box-shadow: 0 12px 28px rgba(185, 28, 43, 0.45);
    color: #ffffff;
}
.farmacia-chatbot-fab:active {
    transform: translateY(0);
}
.fab-pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #10B981;
    box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
    animation: fab-pulse 2s infinite;
}
@@keyframes fab-pulse {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
    70% { transform: scale(1); box-shadow: 0 0 0 8px rgba(16, 185, 129, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
}
.fab-icon {
    font-size: 1.15rem;
}

/* Backdrop */
.farmacia-chatbot-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(23, 32, 51, 0.35);
    backdrop-filter: blur(2px);
    z-index: 1048;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s ease, visibility 0.25s ease;
}
.farmacia-chatbot-backdrop.is-open {
    opacity: 1;
    visibility: visible;
}

/* Chatbot Drawer */
.farmacia-chatbot-drawer {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: 440px;
    max-width: 95vw;
    background: #ffffff;
    z-index: 1050;
    box-shadow: -8px 0 32px rgba(23, 32, 51, 0.16);
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}
.farmacia-chatbot-drawer.is-open {
    transform: translateX(0);
}

/* Drawer Header */
.chatbot-header {
    background: #172033;
    color: #ffffff;
    padding: 1rem 1.25rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}
.chatbot-avatar {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: rgba(185, 28, 43, 0.25);
    border: 1px solid rgba(185, 28, 43, 0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
    position: relative;
}
.online-indicator {
    position: absolute;
    bottom: -2px;
    right: -2px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #10B981;
    border: 2px solid #172033;
}
.chatbot-title {
    color: #ffffff;
    font-size: 0.98rem;
}
.chatbot-subtitle {
    color: #9CA3AF;
    font-size: 0.75rem;
}
.btn-chatbot-tool, .btn-chatbot-close {
    background: rgba(255, 255, 255, 0.1);
    color: #ffffff;
    border: none;
    border-radius: 8px;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    transition: background 0.15s;
}
.btn-chatbot-tool:hover, .btn-chatbot-close:hover {
    background: rgba(255, 255, 255, 0.2);
    color: #ffffff;
}

/* Disclaimer Notice */
.chatbot-disclaimer {
    background: #FFFBEB;
    border-bottom: 1px solid #FDE68A;
    color: #92400E;
    padding: 0.5rem 0.85rem;
    font-size: 0.74rem;
    line-height: 1.35;
    display: flex;
    align-items: flex-start;
    gap: 6px;
}

/* Message Scroll Area */
.chatbot-messages {
    flex: 1;
    overflow-y: auto;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    background: #F8FAFC;
}

/* Message Bubbles */
.chat-row {
    display: flex;
    gap: 8px;
    align-items: flex-end;
    max-width: 92%;
}
.chat-row.user {
    align-self: flex-end;
    flex-direction: row-reverse;
}
.chat-row.bot {
    align-self: flex-start;
}
.chat-avatar-mini {
    width: 28px;
    height: 28px;
    border-radius: 8px;
    background: #E2E8F0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
    flex-shrink: 0;
}
.chat-bubble {
    padding: 0.75rem 1rem;
    border-radius: 14px;
    font-size: 0.88rem;
    line-height: 1.45;
    position: relative;
    word-break: break-word;
}
.chat-row.user .chat-bubble {
    background: #172033;
    color: #ffffff;
    border-bottom-right-radius: 4px;
}
.chat-row.bot .chat-bubble {
    background: #ffffff;
    color: #1E293B;
    border: 1px solid #E2E8F0;
    border-bottom-left-radius: 4px;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.04);
}

/* Product Card in Chat */
.chat-product-card {
    background: #ffffff;
    border: 1px solid #E2E8F0;
    border-radius: 10px;
    padding: 0.75rem;
    margin-top: 0.5rem;
    transition: border-color 0.15s, box-shadow 0.15s;
}
.chat-product-card:hover {
    border-color: #CBD5E1;
    box-shadow: 0 4px 12px rgba(23, 32, 51, 0.06);
}
.chat-product-title {
    font-weight: 700;
    font-size: 0.9rem;
    color: #172033;
    margin-bottom: 2px;
}
.chat-product-price {
    color: #B91C2B;
    font-weight: 700;
    font-size: 0.92rem;
}
.chat-product-explanation {
    font-size: 0.8rem;
    color: #475569;
    margin: 4px 0;
}
.chat-product-warning {
    font-size: 0.75rem;
    color: #DC2626;
    background: #FEF2F2;
    padding: 2px 6px;
    border-radius: 4px;
    display: inline-block;
    margin-bottom: 6px;
}
.chat-product-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 6px;
    gap: 6px;
}

/* Quick Categories Chips */
.chatbot-quick-bar {
    padding: 0.5rem 0.85rem;
    background: #ffffff;
    border-top: 1px solid #E2E8F0;
    display: flex;
    gap: 6px;
    overflow-x: auto;
    white-space: nowrap;
}
.category-chip {
    padding: 4px 10px;
    background: #F1F5F9;
    border: 1px solid #CBD5E1;
    border-radius: 9999px;
    font-size: 0.76rem;
    font-weight: 600;
    color: #334155;
    cursor: pointer;
    transition: all 0.15s;
    flex-shrink: 0;
}
.category-chip:hover {
    background: #B91C2B;
    border-color: #B91C2B;
    color: #ffffff;
}

/* Chat Input Bar */
.chatbot-input-container {
    padding: 0.75rem 1rem;
    background: #ffffff;
    border-top: 1px solid #E2E8F0;
}
.chatbot-input {
    border-radius: 9999px;
    padding: 0.55rem 1rem;
    font-size: 0.88rem;
    border: 1px solid #CBD5E1;
}
.chatbot-input:focus {
    border-color: #B91C2B;
    box-shadow: 0 0 0 3px rgba(185, 28, 43, 0.15);
}
.chatbot-send-btn {
    border-radius: 50%;
    width: 38px;
    height: 38px;
    background: #B91C2B;
    color: #ffffff;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.95rem;
    flex-shrink: 0;
    transition: background 0.15s, transform 0.1s;
}
.chatbot-send-btn:hover {
    background: #9b1724;
    color: #ffffff;
    transform: scale(1.05);
}

/* Typing Indicator Animation */
.typing-dots {
    display: inline-flex;
    gap: 4px;
    padding: 4px 6px;
}
.typing-dots span {
    width: 6px;
    height: 6px;
    background: #94A3B8;
    border-radius: 50%;
    animation: typing-blink 1.4s infinite both;
}
.typing-dots span:nth-child(2) { animation-delay: 0.2s; }
.typing-dots span:nth-child(3) { animation-delay: 0.4s; }
@@keyframes typing-blink {
    0%, 80%, 100% { opacity: 0.2; transform: scale(0.8); }
    40% { opacity: 1; transform: scale(1.1); }
}
</style>

<script>
(function () {
    'use strict';

    var currentRecId = null;
    var customerGivenName = '@givenName';
    var categoriesCache = [];

    var drawer = document.getElementById('farmaciaChatbotDrawer');
    var backdrop = document.getElementById('farmaciaChatbotBackdrop');
    var fab = document.getElementById('farmaciaChatbotFab');
    var closeBtn = document.getElementById('farmaciaChatbotCloseBtn');
    var resetBtn = document.getElementById('farmaciaChatbotResetBtn');
    var form = document.getElementById('farmaciaChatForm');
    var input = document.getElementById('farmaciaChatInput');
    var messagesContainer = document.getElementById('farmaciaChatMessages');
    var quickBar = document.getElementById('farmaciaQuickCategories');

    function openChatbot() {
        if (!drawer) return;
        drawer.classList.add('is-open');
        if (backdrop) backdrop.classList.add('is-open');
        if (input) setTimeout(function () { input.focus(); }, 300);
        if (messagesContainer && messagesContainer.children.length === 0) {
            initChat();
        }
    }

    function closeChatbot() {
        if (!drawer) return;
        drawer.classList.remove('is-open');
        if (backdrop) backdrop.classList.remove('is-open');
    }

    function toggleChatbot() {
        if (drawer && drawer.classList.contains('is-open')) {
            closeChatbot();
        } else {
            openChatbot();
        }
    }

    if (fab) fab.addEventListener('click', toggleChatbot);
    if (closeBtn) closeBtn.addEventListener('click', closeChatbot);
    if (backdrop) backdrop.addEventListener('click', closeChatbot);
    if (resetBtn) resetBtn.addEventListener('click', resetChat);

    // Expose global controller
    window.FarmaciaChatbot = {
        open: openChatbot,
        close: closeChatbot,
        toggle: toggleChatbot,
        startCategory: function (categoryId, categoryName) {
            openChatbot();
            appendUserBubble(categoryName);
            sendChatRequest({ categoryId: categoryId });
        }
    };

    function appendUserBubble(text) {
        var row = document.createElement('div');
        row.className = 'chat-row user';
        var bubble = document.createElement('div');
        bubble.className = 'chat-bubble';
        bubble.textContent = text;
        row.appendChild(bubble);
        messagesContainer.appendChild(row);
        scrollToBottom();
    }

    function appendBotBubble(htmlContent) {
        var row = document.createElement('div');
        row.className = 'chat-row bot';
        
        var avatar = document.createElement('div');
        avatar.className = 'chat-avatar-mini';
        avatar.innerHTML = '&#129502;';
        row.appendChild(avatar);

        var bubble = document.createElement('div');
        bubble.className = 'chat-bubble';
        bubble.innerHTML = htmlContent;
        row.appendChild(bubble);

        messagesContainer.appendChild(row);
        scrollToBottom();
    }

    function showTypingIndicator() {
        var id = 'typingIndicator_' + Date.now();
        var row = document.createElement('div');
        row.className = 'chat-row bot';
        row.id = id;

        var avatar = document.createElement('div');
        avatar.className = 'chat-avatar-mini';
        avatar.innerHTML = '&#129502;';
        row.appendChild(avatar);

        var bubble = document.createElement('div');
        bubble.className = 'chat-bubble';
        bubble.innerHTML = '<div class="typing-dots"><span></span><span></span><span></span></div>';
        row.appendChild(bubble);

        messagesContainer.appendChild(row);
        scrollToBottom();
        return id;
    }

    function removeTypingIndicator(id) {
        var elem = document.getElementById(id);
        if (elem) elem.remove();
    }

    function scrollToBottom() {
        if (messagesContainer) {
            messagesContainer.scrollTop = messagesContainer.scrollHeight;
        }
    }

    function initChat() {
        fetch('/CustomerPortal/Recommendation/GetInitialState')
            .then(function (r) { return r.json(); })
            .then(function (data) {
                customerGivenName = data.customerName || customerGivenName;
                categoriesCache = data.categories || [];
                renderQuickChips(categoriesCache);

                var welcomeHtml = '<div>Hello <strong>' + escapeHtml(customerGivenName) + '</strong>! 👋 I am your Farmacia San Antonio AI Assistant.</div>' +
                    '<div class="mt-1 small text-muted">What symptom or health concern are you looking to relieve today? Tap a category below or type your question:</div>';
                appendBotBubble(welcomeHtml);
            })
            .catch(function () {
                appendBotBubble('Hello! 👋 How can I help you find OTC remedies today? You can type your symptoms or health concern below.');
            });
    }

    function resetChat() {
        if (!messagesContainer) return;
        messagesContainer.innerHTML = '';
        currentRecId = null;
        initChat();
    }

    function renderQuickChips(categories) {
        if (!quickBar) return;
        quickBar.innerHTML = '';
        if (!categories || categories.length === 0) {
            quickBar.style.display = 'none';
            return;
        }
        quickBar.style.display = 'flex';
        categories.forEach(function (cat) {
            var chip = document.createElement('button');
            chip.type = 'button';
            chip.className = 'category-chip';
            chip.textContent = cat.name;
            chip.addEventListener('click', function () {
                appendUserBubble(cat.name);
                sendChatRequest({ categoryId: cat.id });
            });
            quickBar.appendChild(chip);
        });
    }

    if (form) {
        form.addEventListener('submit', function (e) {
            e.preventDefault();
            var text = input.value.trim();
            if (!text) return;
            input.value = '';
            appendUserBubble(text);
            sendChatRequest({ message: text, currentRecommendationId: currentRecId });
        });
    }

    function sendChatRequest(payload) {
        var typingId = showTypingIndicator();

        fetch('/CustomerPortal/Recommendation/ChatMessage', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(payload)
        })
        .then(function (res) { return res.json(); })
        .then(function (data) {
            removeTypingIndicator(typingId);
            handleChatResponse(data);
        })
        .catch(function (err) {
            removeTypingIndicator(typingId);
            appendBotBubble('Sorry, I encountered a temporary connection issue. Please try asking again.');
        });
    }

    function handleChatResponse(data) {
        if (data.requiresCategory && data.categories) {
            var catHtml = '<div>' + escapeHtml(data.reply) + '</div><div class="mt-2 d-flex flex-wrap gap-1">';
            data.categories.forEach(function (c) {
                catHtml += '<button type="button" class="btn btn-sm btn-outline-secondary rounded-pill py-1 px-2 m-1" onclick="window.FarmaciaChatbot.startCategory(' + c.id + ', \'' + escapeHtml(c.name) + '\')">' + escapeHtml(c.name) + '</button>';
            });
            catHtml += '</div>';
            appendBotBubble(catHtml);
            return;
        }

        if (!data.success && !data.items) {
            appendBotBubble(escapeHtml(data.reply || 'No recommendations could be found.'));
            return;
        }

        if (data.recommendationId) {
            currentRecId = data.recommendationId;
        }

        var html = '<div>' + formatMarkdown(data.reply) + '</div>';

        if (data.items && data.items.length > 0) {
            data.items.forEach(function (item) {
                html += '<div class="chat-product-card" id="chatProdCard_' + item.id + '">' +
                    '<div class="d-flex justify-content-between align-items-baseline">' +
                        '<div class="chat-product-title">' + escapeHtml(item.productName) + '</div>' +
                        '<div class="chat-product-price">&#8369;' + Number(item.price).toFixed(2) + '</div>' +
                    '</div>' +
                    '<div class="chat-product-explanation">' + escapeHtml(item.explanation) + '</div>';

                if (item.warning) {
                    html += '<div class="chat-product-warning">&#9888; ' + escapeHtml(item.warning) + '</div>';
                }

                html += '<div class="chat-product-actions">' +
                    '<button type="button" class="btn btn-sm btn-primary rounded-pill px-3 py-1 text-white" onclick="window.FarmaciaChatbotHelper.addToCart(' + item.productId + ', \'' + escapeHtml(item.productName) + '\', ' + item.price + ', this)">' +
                        '<span>+ Add to Cart</span>' +
                    '</button>' +
                    '<div class="d-flex gap-1" id="feedbackGroup_' + item.id + '">' +
                        '<button type="button" class="btn btn-sm btn-outline-secondary border-0" title="Helpful" onclick="window.FarmaciaChatbotHelper.feedback(' + item.id + ', ' + data.recommendationId + ', 0, this)">&#128077;</button>' +
                        '<button type="button" class="btn btn-sm btn-outline-secondary border-0" title="Not Helpful" onclick="window.FarmaciaChatbotHelper.feedback(' + item.id + ', ' + data.recommendationId + ', 1, this)">&#128078;</button>' +
                    '</div>' +
                '</div>' +
                '</div>';
            });

            html += '<div class="mt-2 small text-muted fst-italic">Need budget options? Type <em>"Show cheaper options"</em> or pick another concern above.</div>';
        }

        appendBotBubble(html);
    }

    // Chatbot helper for onclick handlers
    window.FarmaciaChatbotHelper = {
        addToCart: function (productId, productName, unitPrice, btn) {
            var origText = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';

            fetch('/CustomerPortal/Recommendation/AddToCartAjax', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ productId: productId, productName: productName, unitPrice: unitPrice, quantity: 1 })
            })
            .then(function (r) { return r.json(); })
            .then(function (res) {
                btn.innerHTML = '&#10003; Added!';
                btn.classList.remove('btn-primary');
                btn.classList.add('btn-success');
                setTimeout(function () {
                    btn.disabled = false;
                    btn.innerHTML = origText;
                    btn.classList.remove('btn-success');
                    btn.classList.add('btn-primary');
                }, 2000);
            })
            .catch(function () {
                btn.disabled = false;
                btn.innerHTML = origText;
            });
        },
        feedback: function (itemId, recId, rating, btn) {
            var group = document.getElementById('feedbackGroup_' + itemId);
            fetch('/CustomerPortal/Recommendation/FeedbackAjax', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ recommendationItemId: itemId, recommendationId: recId, rating: rating })
            })
            .then(function () {
                if (group) {
                    group.innerHTML = '<span class="badge bg-light text-success border">&#10003; Feedback noted</span>';
                }
            });
        }
    };

    function escapeHtml(str) {
        if (!str) return '';
        return String(str)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
    }

    function formatMarkdown(str) {
        if (!str) return '';
        var escaped = escapeHtml(str);
        // Replace **bold**
        escaped = escaped.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
        return escaped;
    }
})();
</script>
