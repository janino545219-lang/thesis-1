@using FarmaciaSmart.Web.Models.ViewModels
@model PagedResult<Notification>
@{
    ViewData["Title"] = "Notifications";
}

<h2>Notifications</h2>
<p class="form-text">@Model.TotalCount total. Page @Model.Page of @Model.TotalPages.</p>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}

<p>
    <form asp-action="GenerateNow" method="post" class="d-inline">
        <button type="submit" class="btn btn-outline-primary">Check Now</button>
    </form>
</p>
<p class="text-muted"><small>Also runs automatically in the background every 15 minutes.</small></p>

<div class="table-responsive">
<table class="table table-bordered">
    <thead>
        <tr>
            <th>Date</th>
            <th>Type</th>
            <th>Branch</th>
            <th>Message</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var n in Model.Items)
    {
        <tr class="@(n.IsRead ? "" : "table-warning")">
            <td>@n.CreatedAt.ToString("g")</td>
            <td>@n.Type</td>
            <td>@(n.Branch?.Name ?? "All")</td>
            <td>@n.Message</td>
            <td>@(n.IsRead ? "Read" : "Unread")</td>
            <td>
                @if (!n.IsRead)
                {
                    <form asp-action="MarkAsRead" asp-route-id="@n.Id" method="post" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-outline-secondary">Mark as Read</button>
                    </form>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
</div>

<partial name="_Pager" model="(Model.Page, Model.TotalPages)" />
