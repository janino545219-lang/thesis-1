@model List<RecommendationRule>
@{
    ViewData["Title"] = "Recommendation Rules";
}

<h2>Recommendation Rules (Pharmacist Knowledge Base)</h2>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<p>
    <a asp-action="Create" class="btn btn-primary">Create New Rule</a>
    <form asp-action="GenerateEmbeddings" method="post" class="d-inline">
        <button type="submit" class="btn btn-outline-secondary">Generate/Refresh Product Embeddings</button>
    </form>
</p>
<p class="text-muted"><small>Embeddings power semantic candidate broadening when rule matches are sparse (Stage 10).</small></p>

<div class="table-responsive">
<table class="table table-bordered">
    <thead>
        <tr>
            <th>Trigger</th>
            <th>Category</th>
            <th>Product</th>
            <th>Pharmacist Approved</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var rule in Model)
    {
        <tr>
            <td>@rule.Trigger</td>
            <td>@rule.Category.Name</td>
            <td>@(rule.Product?.Name ?? "Any eligible product in category")</td>
            <td>@(rule.PharmacistApproved ? "Yes" : "No")</td>
            <td>
                @if (rule.IsActive)
                {
                    <span class="badge bg-success">Active</span>
                }
                else
                {
                    <span class="badge bg-secondary">Inactive</span>
                }
            </td>
            <td>
                <a asp-action="Details" asp-route-id="@rule.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                <a asp-action="Edit" asp-route-id="@rule.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                <form asp-action="ToggleActive" asp-route-id="@rule.Id" method="post" class="d-inline">
                    <input type="hidden" name="isActive" value="@(!rule.IsActive)" />
                    <button type="submit" class="btn btn-sm btn-outline-warning">
                        @(rule.IsActive ? "Deactivate" : "Activate")
                    </button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
</div>
